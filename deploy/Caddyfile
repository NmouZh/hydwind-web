# Hydwind 网站反代示例（Caddy 2）
#
# 作用：
# - 自动申请/续期 TLS，HTTP 自动 301 到 HTTPS；
# - zstd/gzip 压缩（Node standalone 自身不压缩）；
# - 静态资源直接由 Caddy 提供，不进 Node；/_astro 内容哈希，长缓存；
# - 字体/图片没有内容哈希，用一周缓存而不是 immutable，更新后最多一周生效；
# - SSR/API 反代到只监听 127.0.0.1 的 Node 服务。
#
# 用法：把 hydwind.example.com 换成真实域名，Node 的 .env 设置
# HOST=127.0.0.1 PORT=4321，并把域名加进 astro.config.mjs 的
# security.allowedDomains 后重新构建。

hydwind.example.com {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		-Server
	}

	# 这些路由由 Node 运行时处理
	@ssr path /api/* /people /people/* /gate /gate/* /login /login/* /edit /edit/*
	handle @ssr {
		reverse_proxy 127.0.0.1:4321
	}

	# 其余全部是构建期静态文件
	handle {
		root * /opt/hydwind-web/dist/client

		# file 匹配器保证文件真的存在才加长缓存；否则不存在的 .js/图片
		# 会带着 immutable 的 404 被 CDN 缓存一年。
		@hashed {
			path /_astro/*
			file {path}
		}
		header @hashed Cache-Control "public, max-age=31536000, immutable"

		@stable {
			path /fonts/* /images/*
			file {path}
		}
		header @stable Cache-Control "public, max-age=604800, stale-while-revalidate=86400"

		try_files {path} {path}/ =404
		file_server
	}

	# 保持真实 404 状态码，同时返回站点自己的错误页。
	handle_errors {
		rewrite * /404.html
		file_server
	}
}