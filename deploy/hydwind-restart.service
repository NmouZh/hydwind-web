[Unit]
Description=Restart Hydwind website on request
After=hydwind-web.service
# 防止请求文件反复出现时无限重启；三次失败后需要人工处理。
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=oneshot

# restart.sh 会重启服务、轮询 /api/health?ready=1，成功后才删除请求文件。
# 失败时保留文件并让 unit 失败，运维能在 journalctl 里看到原因。
Environment=HYDWIND_HEALTH_URL=http://127.0.0.1:4321/api/health?ready=1
ExecStart=/opt/hydwind-web/deploy/restart.sh