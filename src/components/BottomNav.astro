---
import Icon from './Icon.astro';
import { NAV_ITEMS, type NavKey } from '../lib/nav';

interface Props {
  current?: NavKey;
}

const { current = 'home' } = Astro.props;
---

<nav class="bottom-nav" aria-label="底部导航">
  {
    NAV_ITEMS.map((item) => (
      <a
        href={item.href}
        data-nav-key={item.key}
        data-astro-prefetch={item.key === 'people' ? 'false' : undefined}
        aria-current={current === item.key ? 'page' : undefined}
        class="state-layer"
      >
        <span class="nav-indicator">
          <span class="nav-active-pill" aria-hidden="true"></span>
          <Icon name={item.icon} size={22} />
        </span>
        <span class="nav-label">{item.label}</span>
      </a>
    ))
  }
</nav>

<style>
  .bottom-nav {
    display: none;
  }

  @media (max-width: 839px) {
    .bottom-nav {
      position: fixed;
      right: 0;
      bottom: 0;
      left: 0;
      z-index: 70;
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 2px;
      padding: 6px 6px calc(6px + env(safe-area-inset-bottom));
      border-top: 1px solid var(--md-sys-color-outline-variant);
      /* 实心底：底栏不再依赖毛玻璃，换页快照不会整条消失 */
      background: var(--md-sys-color-surface);
    }

    .bottom-nav a {
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 2px;
      min-height: 58px;
      border-radius: var(--md-sys-shape-corner-medium);
      color: var(--md-sys-color-on-surface-variant);
      font-size: var(--md-sys-typescale-label-medium-size);
      font-weight: 600;
      isolation: isolate;
      transition: color var(--md-sys-motion-duration-short4)
        var(--md-sys-motion-easing-standard);
    }

    .nav-indicator {
      position: relative;
      display: grid;
      place-items: center;
      width: 58px;
      height: 30px;
      border-radius: var(--md-sys-shape-corner-full);
      isolation: isolate;
    }

    /* 当前项胶囊：跨页时作为共享元素滑动，图标和文字不动 */
    .nav-active-pill {
      position: absolute;
      inset: 0;
      z-index: -1;
      border-radius: inherit;
      background: var(--md-sys-color-primary-container);
      opacity: 0;
      transform: scale(0.8);
      transition:
        opacity var(--md-sys-motion-duration-short4)
          var(--md-sys-motion-easing-standard),
        transform var(--md-sys-motion-duration-medium1)
          var(--md-sys-motion-easing-emphasized);
      pointer-events: none;
    }

    .bottom-nav a[aria-current='page'] {
      color: var(--md-sys-color-primary);
    }

    .bottom-nav a[aria-current='page'] .nav-indicator {
      color: var(--md-sys-color-on-primary-container);
    }

    .bottom-nav a[aria-current='page'] .nav-active-pill {
      opacity: 1;
      transform: none;
      view-transition-name: nav-bottom-active;
    }

    .bottom-nav a[data-pressed] {
      transform: scale(0.94);
    }

    @media (prefers-reduced-motion: reduce) {
      .nav-active-pill {
        transition: none;
      }
    }
  }
</style>
