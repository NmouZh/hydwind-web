---
import Icon from './Icon.astro';
import type { SiteInfo } from '../lib/content';

interface Props {
  site: SiteInfo;
}

const { site } = Astro.props;
---

<section class="server-info" aria-labelledby="server-info-title">
  <header class="server-info-heading">
    <div>
      <p class="hw-eyebrow">服务器信息</p>
      <h2 id="server-info-title">进服前先确认这些</h2>
    </div>
    <span class="assist-chip" data-live-status>{site.statusLabel}</span>
  </header>

  <p class="server-info-live" data-live-detail hidden></p>

  <dl class="server-info-grid">
    <div class="server-info-item">
      <dt>服务器地址</dt>
      <dd class="server-info-value">
        <code>{site.address}</code>
        <button
          class="text-button server-info-copy"
          type="button"
          data-copy={site.address}
          aria-label={`复制服务器地址 ${site.address}`}
        >
          <Icon name="copy" size={16} />
          复制
        </button>
      </dd>
    </div>
    <div class="server-info-item">
      <dt>客户端版本</dt>
      <dd class="server-info-value">Java 版 {site.clientVersions}</dd>
    </div>
    <div class="server-info-item">
      <dt>验证方式</dt>
      <dd class="server-info-value">{site.authentication}</dd>
    </div>
    <div class="server-info-item">
      <dt>收费</dt>
      <dd class="server-info-value">{site.pricing}</dd>
    </div>
    <div class="server-info-item">
      <dt>QQ 群</dt>
      <dd class="server-info-value">
        <code>{site.qqGroup}</code>
        <button
          class="text-button server-info-copy"
          type="button"
          data-copy={site.qqGroup}
          aria-label={`复制 QQ 群号 ${site.qqGroup}`}
        >
          <Icon name="copy" size={16} />
          复制
        </button>
      </dd>
    </div>
  </dl>

  <div class="server-info-notes">
    <p><strong>客户端要求：</strong>{site.clientRequirement}。</p>
    <p><strong>进服限制：</strong>{site.joinLimit}。</p>
    <p class="notice server-info-notice">
      <span><strong>测试期提示：</strong>{site.testingNotice}。</span>
    </p>
    <p class="server-info-version-note">{site.versionNote}</p>
  </div>
</section>

<script>
  // 页面本身是构建期静态产物，这里在浏览器端补一次实时状态：
  // /api/status 不可用（纯静态部署、接口挂掉）时保持 Markdown 里的原文，不影响阅读。
  type Status = {
    online: boolean;
    players: { online: number; max: number };
    version: string;
    checkedAt: string;
  };

  const chip = document.querySelector<HTMLElement>('[data-live-status]');
  const detail = document.querySelector<HTMLElement>('[data-live-detail]');

  if (chip && detail) {
    const original = chip.textContent ?? '';

    fetch('/api/status', { headers: { accept: 'application/json' } })
      .then((response) => (response.ok ? response.json() : Promise.reject(new Error('status'))) )
      .then((status: Status) => {
        chip.textContent = status.online ? '在线' : '离线';
        chip.dataset.state = status.online ? 'online' : 'offline';

        const time = new Date(status.checkedAt).toLocaleTimeString('zh-CN', {
          hour: '2-digit',
          minute: '2-digit',
        });
        detail.textContent = status.online
          ? `当前在线 ${status.players.online}/${status.players.max} 人 · ${status.version} · ${time} 更新`
          : `服务器暂时没响应，可以去 QQ 群问问 · ${time} 检查`;
        detail.hidden = false;
      })
      .catch(() => {
        chip.textContent = original;
      });
  }
</script>

<style>
  .server-info-live {
    margin-top: var(--hw-space-3);
    color: var(--md-sys-color-on-surface-variant);
    font-size: var(--md-sys-typescale-label-medium-size);
  }

  .server-info [data-live-status][data-state='online'] {
    background: var(--md-sys-color-primary-container);
    color: var(--md-sys-color-on-primary-container);
    border-color: transparent;
  }

  .server-info [data-live-status][data-state='offline'] {
    background: var(--md-sys-color-error-container);
    color: var(--md-sys-color-on-error-container);
  }

  .server-info {
    padding-block: clamp(32px, 4.5vw, 56px);
    border-top: 1px solid var(--md-sys-color-outline-variant);
  }

  .server-info-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--hw-space-3) var(--hw-space-4);
  }

  .server-info-heading h2 {
    margin-top: var(--hw-space-3);
    font-size: var(--md-sys-typescale-headline-medium-size);
  }

  .server-info-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    margin-top: clamp(24px, 3vw, 36px);
    border-top: 1px solid var(--md-sys-color-outline-variant);
  }

  .server-info-item {
    min-width: 0;
    padding: var(--hw-space-4) var(--hw-space-5) var(--hw-space-4) 0;
    border-bottom: 1px solid var(--md-sys-color-outline-variant);
  }

  @media (max-width: 839px) {
    .server-info-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .server-info-item dt {
    color: var(--md-sys-color-on-surface-variant);
    font-size: var(--md-sys-typescale-label-small-size);
    font-weight: 500;
  }

  .server-info-value {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 12px;
    margin-top: 4px;
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.5;
  }

  .server-info-value code {
    font-size: 1rem;
    word-break: break-all;
  }

  .server-info-copy {
    min-height: 32px;
    margin-left: auto;
    padding: 0 8px;
    color: var(--md-sys-color-primary);
    font-size: var(--md-sys-typescale-label-medium-size);
  }

  .server-info-notes {
    display: grid;
    gap: var(--hw-space-2);
    margin-top: var(--hw-space-5);
    color: var(--md-sys-color-on-surface-variant);
    font-size: var(--md-sys-typescale-body-medium-size);
    line-height: 1.7;
  }

  .server-info-notes strong {
    color: var(--md-sys-color-on-surface);
  }

  .server-info-notice {
    margin-top: 4px;
  }

  .server-info-version-note {
    font-size: var(--md-sys-typescale-label-small-size);
  }
</style>
