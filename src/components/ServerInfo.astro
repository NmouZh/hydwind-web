---
import Icon from './Icon.astro';
import type { SiteInfo } from '../lib/content';

interface Props {
  site: SiteInfo;
}

const { site } = Astro.props;
---

<section class="server-card" aria-labelledby="server-info-title">
  <header class="server-card-head">
    <div>
      <p class="hw-eyebrow">Server</p>
      <h2 id="server-info-title">服务器信息</h2>
    </div>
    <span class="assist-chip" data-live-status>{site.statusLabel}</span>
  </header>

  <p class="server-card-live" data-live-detail hidden></p>

  <div class="server-card-primary">
    <span class="server-card-label">服务器地址</span>
    <div class="server-card-value">
      <code>{site.address}</code>
      <button
        class="server-card-copy"
        type="button"
        data-copy={site.address}
        aria-label={`复制服务器地址 ${site.address}`}
      >
        <Icon name="copy" size={16} />
        复制
      </button>
    </div>
  </div>

  <div class="server-card-primary">
    <span class="server-card-label">QQ 群</span>
    <div class="server-card-value">
      <code>{site.qqGroup}</code>
      <button
        class="server-card-copy"
        type="button"
        data-copy={site.qqGroup}
        aria-label={`复制 QQ 群号 ${site.qqGroup}`}
      >
        <Icon name="copy" size={16} />
        复制
      </button>
    </div>
  </div>

  <dl class="server-card-grid">
    <div>
      <dt>客户端</dt>
      <dd>Java 版 {site.clientVersions}</dd>
    </div>
    <div>
      <dt>验证方式</dt>
      <dd>{site.authentication}</dd>
    </div>
    <div>
      <dt>收费</dt>
      <dd>{site.pricing}</dd>
    </div>
    <div>
      <dt>进服限制</dt>
      <dd>{site.joinLimit}</dd>
    </div>
  </dl>

  <p class="server-card-note"><strong>客户端要求：</strong>{site.clientRequirement}。</p>
  <p class="server-card-note notice"><strong>测试期提示：</strong>{site.testingNotice}。</p>
  <p class="server-card-note">{site.versionNote}</p>
</section>

<script>
  // 页面本身是构建期静态产物，这里在浏览器端补一次实时状态：
  // /api/status 不可用（纯静态部署、接口挂掉）时保持 Markdown 里的原文，不影响阅读。
  type Status = {
    online: boolean;
    players: { online: number; max: number };
    version: string;
    checkedAt: string;
  };

  const chip = document.querySelector<HTMLElement>('[data-live-status]');
  const detail = document.querySelector<HTMLElement>('[data-live-detail]');

  if (chip && detail) {
    const original = chip.textContent ?? '';

    fetch('/api/status', { headers: { accept: 'application/json' } })
      .then((response) => (response.ok ? response.json() : Promise.reject(new Error('status'))))
      .then((status: Status) => {
        chip.textContent = status.online ? '在线' : '离线';
        chip.dataset.state = status.online ? 'online' : 'offline';

        const time = new Date(status.checkedAt).toLocaleTimeString('zh-CN', {
          hour: '2-digit',
          minute: '2-digit',
        });
        detail.textContent = status.online
          ? `当前在线 ${status.players.online}/${status.players.max} 人 · ${status.version} · ${time} 更新`
          : `服务器暂时没响应，可以去 QQ 群问问 · ${time} 检查`;
        detail.hidden = false;
      })
      .catch(() => {
        chip.textContent = original;
      });
  }
</script>
