---
interface Step {
  title: string;
  text: string;
}

interface Props {
  steps: Step[];
  /** route：指南详情页的路线布局；join：首页进服区的情境布局。 */
  variant?: 'route' | 'join';
}

const { steps, variant = 'route' } = Astro.props;
---

{
  variant === 'route' ? (
    <ol class="guide-route">
      {steps.map((step, index) => (
        <li
          class="guide-route-item"
          id={`step-${index + 1}`}
          data-reveal
          style={`--reveal-delay: ${index * 70}ms`}
        >
          <span class="guide-route-number" aria-hidden="true">
            {String(index + 1).padStart(2, '0')}
          </span>
          <div>
            <h3 class="guide-route-title">{step.title}</h3>
            <p class="guide-route-text">{step.text}</p>
          </div>
        </li>
      ))}
    </ol>
  ) : (
    <ol class="guide-steps guide-steps--join">
      {steps.map((step, index) => (
        <li>
          <span class="step-number">{String(index + 1).padStart(2, '0')}</span>
          <div>
            <strong>{step.title}</strong>
            <p>{step.text}</p>
          </div>
        </li>
      ))}
    </ol>
  )
}

<style>
  /* 首页进服区专用的紧凑步骤；路线变体的样式在 src/styles/guides.css */
  .guide-steps {
    display: grid;
    gap: 0;
  }

  .guide-steps li {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: var(--hw-space-3);
  }

  .step-number {
    color: color-mix(
      in srgb,
      var(--md-sys-color-on-primary-container) 66%,
      transparent
    );
    font-size: var(--md-sys-typescale-label-small-size);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.1em;
    padding-top: 2px;
  }

  .guide-steps strong {
    display: block;
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.4;
  }

  .guide-steps p {
    margin-top: 3px;
    color: var(--md-sys-color-on-primary-container);
    font-size: var(--md-sys-typescale-body-medium-size);
    line-height: 1.7;
  }

  .guide-steps--join {
    margin-top: 0;
  }

  .guide-steps--join li {
    padding: var(--hw-space-3) 0;
    border-top: 1px solid
      color-mix(
        in srgb,
        var(--md-sys-color-on-primary-container) 16%,
        transparent
      );
  }

  .guide-steps--join li:first-child {
    padding-top: 0;
    border-top: 0;
  }

  @media (max-width: 839px) {
    .guide-steps--join li:first-child {
      padding-top: var(--hw-space-3);
      border-top: 1px solid
        color-mix(
          in srgb,
          var(--md-sys-color-on-primary-container) 16%,
          transparent
        );
    }
  }
</style>
