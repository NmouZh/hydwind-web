---
interface Step {
  title: string;
  text: string;
}

interface Props {
  steps: Step[];
  /** cards：指南详情页的卡片布局；join：首页进服区的情境布局。 */
  variant?: 'cards' | 'join';
}

const { steps, variant = 'cards' } = Astro.props;
---

<ol class:list={['guide-steps', `guide-steps--${variant}`]}>
  {
    steps.map((step, index) => (
      <li>
        <span class="step-number">{String(index + 1).padStart(2, '0')}</span>
        <div>
          <strong>{step.title}</strong>
          <p>{step.text}</p>
        </div>
      </li>
    ))
  }
</ol>

<style>
  .guide-steps {
    display: grid;
    gap: 0;
    margin-top: var(--hw-space-4);
  }

  .guide-steps li {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: var(--hw-space-3);
  }

  .step-number {
    color: var(--md-sys-color-primary);
    font-size: var(--md-sys-typescale-label-small-size);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.1em;
    padding-top: 2px;
  }

  .guide-steps strong {
    display: block;
    font-size: var(--md-sys-typescale-title-large-size);
    font-weight: 600;
    line-height: 1.4;
  }

  .guide-steps p {
    margin-top: 3px;
    color: var(--md-sys-color-on-surface-variant);
    font-size: var(--md-sys-typescale-body-medium-size);
    line-height: 1.7;
  }

  .guide-steps--cards li {
    padding-block: var(--hw-space-4);
    border-top: 1px solid var(--md-sys-color-outline-variant);
  }

  .guide-steps--cards li:first-child {
    border-top: 0;
  }

  .guide-steps--join {
    margin-top: 0;
  }

  .guide-steps--join li {
    padding: var(--hw-space-3) 0;
    border-top: 1px solid
      color-mix(
        in srgb,
        var(--md-sys-color-on-primary-container) 16%,
        transparent
      );
  }

  .guide-steps--join li:first-child {
    padding-top: 0;
    border-top: 0;
  }

  .guide-steps--join .step-number {
    color: color-mix(
      in srgb,
      var(--md-sys-color-on-primary-container) 66%,
      transparent
    );
  }

  .guide-steps--join strong {
    font-size: 0.9375rem;
  }

  .guide-steps--join p {
    color: var(--md-sys-color-on-primary-container);
  }

  @media (max-width: 839px) {
    .guide-steps--join li:first-child {
      padding-top: var(--hw-space-3);
      border-top: 1px solid
        color-mix(
          in srgb,
          var(--md-sys-color-on-primary-container) 16%,
          transparent
        );
    }
  }
</style>
