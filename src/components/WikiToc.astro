---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
const items = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3);
---

{
  items.length > 0 && (
    <nav class="wiki-toc" aria-label="本页目录">
      <p class="hw-label">本页目录</p>
      <ul>
        {items.map((heading) => (
          <li class:list={{ 'is-sub': heading.depth === 3 }}>
            <a href={`#${heading.slug}`}>{heading.text}</a>
          </li>
        ))}
      </ul>
    </nav>
  )
}
