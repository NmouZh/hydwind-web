---
import Icon from './Icon.astro';
import { JOIN_GUIDE_ID } from '../lib/content';
import { NAV_ITEMS, type NavKey } from '../lib/nav';

interface Props {
  current?: NavKey;
}

const { current = 'home' } = Astro.props;

const links = NAV_ITEMS;
---

<header class="top-app-bar" data-top-app-bar>
  <div class="hw-shell app-bar-inner">
    <a class="brand" href="/" aria-label="氢风首页">
      <span class="brand-mark" aria-hidden="true">
        <span style="height: 9px; opacity: 0.5;"></span>
        <span style="height: 17px;"></span>
        <span style="height: 13px; opacity: 0.75;"></span>
        <span style="height: 6px; opacity: 0.45;"></span>
      </span>
      <span class="brand-text">
        <span class="brand-title">氢风</span>
        <span class="brand-sub">HYDWIND</span>
      </span>
    </a>

    <nav class="top-nav" aria-label="主导航">
      {
        links.map((link) => (
          <a
            href={link.href}
            data-nav-key={link.key}
            aria-current={current === link.key ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="top-actions">
      <button
        class="icon-button theme-toggle"
        type="button"
        data-theme-toggle
        aria-label="切换到深色模式"
      >
        <Icon name="sun" size={20} class="theme-icon theme-icon-light" />
        <Icon name="moon" size={20} class="theme-icon theme-icon-dark" />
      </button>
      <a class="filled-button join-button" href={`/guides/${JOIN_GUIDE_ID}/`}>
        <Icon name="login" size={16} />
        开始进服
      </a>
    </div>
  </div>
</header>

<script>
  const bar = document.querySelector<HTMLElement>('[data-top-app-bar]');
  let ticking = false;

  const update = () => {
    bar?.toggleAttribute('data-scrolled', window.scrollY > 4);
    ticking = false;
  };

  if (bar) {
    window.addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(update);
      },
      { passive: true }
    );
    update();
  }
</script>

<style>
  .top-app-bar {
    position: sticky;
    top: 0;
    z-index: 60;
    border-bottom: 1px solid transparent;
    background: color-mix(in srgb, var(--md-sys-color-surface) 86%, transparent);
    backdrop-filter: blur(18px) saturate(1.4);
    transition:
      border-color var(--md-sys-motion-duration-short4)
        var(--md-sys-motion-easing-standard),
      background-color var(--md-sys-motion-duration-short4)
        var(--md-sys-motion-easing-standard);
  }

  .top-app-bar[data-scrolled] {
    border-bottom-color: var(--md-sys-color-outline-variant);
    background: color-mix(in srgb, var(--md-sys-color-surface) 94%, transparent);
  }

  .app-bar-inner {
    display: flex;
    align-items: center;
    gap: 16px;
    min-height: var(--hw-bar-height);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 4px;
    margin-left: -4px;
    border-radius: var(--md-sys-shape-corner-medium);
  }

  .brand-mark {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 2px;
    width: 36px;
    height: 36px;
    padding-bottom: 9px;
    border-radius: var(--md-sys-shape-corner-small);
    background: var(--md-sys-color-primary-container);
    transition: transform var(--md-sys-motion-duration-medium1)
      var(--md-sys-motion-easing-emphasized);
  }

  .brand-mark span {
    width: 2px;
    border-radius: var(--md-sys-shape-corner-full);
    background: var(--md-sys-color-on-primary-container);
  }

  @media (hover: hover) and (pointer: fine) {
    .brand:hover .brand-mark {
      transform: translateY(-1px);
    }
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }

  .brand-title {
    font-size: 1.0625rem;
    font-weight: 700;
    letter-spacing: 0.01em;
  }

  .brand-sub {
    margin-top: 4px;
    font-size: 0.5rem;
    font-weight: 600;
    letter-spacing: 0.3em;
    color: var(--md-sys-color-on-surface-variant);
    opacity: 0.7;
  }

  .top-nav {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-left: auto;
  }

  .top-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 38px;
    padding: 0 14px;
    border-radius: var(--md-sys-shape-corner-full);
    color: var(--md-sys-color-on-surface-variant);
    font-size: var(--md-sys-typescale-label-large-size);
    font-weight: 600;
    transition:
      background-color var(--md-sys-motion-duration-short4)
        var(--md-sys-motion-easing-standard),
      color var(--md-sys-motion-duration-short4)
        var(--md-sys-motion-easing-standard);
  }

  .top-nav a[aria-current='page'] {
    background: var(--md-sys-color-primary-container);
    color: var(--md-sys-color-on-primary-container);
  }

  @media (hover: hover) and (pointer: fine) {
    .top-nav a:hover {
      background: var(--md-sys-color-surface-container);
      color: var(--md-sys-color-on-surface);
    }

    .top-nav a[aria-current='page']:hover {
      background: var(--md-sys-color-primary-container);
      color: var(--md-sys-color-on-primary-container);
    }
  }

  .top-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .theme-toggle {
    width: 40px;
    height: 40px;
    color: var(--md-sys-color-on-surface-variant);
  }

  :global(.theme-icon-dark) {
    display: none;
  }

  :global([data-theme='dark'] .theme-icon-light) {
    display: none;
  }

  :global([data-theme='dark'] .theme-icon-dark) {
    display: block;
  }

  .join-button {
    min-height: 40px;
    padding: 0 16px;
    font-size: var(--md-sys-typescale-label-medium-size);
  }

  @media (max-width: 839px) {
    .top-nav {
      display: none;
    }

    .top-actions {
      margin-left: auto;
    }
  }

  @media (max-width: 599px) {
    .join-button {
      display: none;
    }

    .brand-sub {
      display: none;
    }
  }
</style>
