---
import Icon from './Icon.astro';
import PlayerAvatar from './PlayerAvatar.astro';
import { formatDate } from '../lib/format';
import type { PublishedPerson } from '../lib/content';

interface Props {
  person: PublishedPerson;
  headingLevel?: 2 | 3;
  delay?: number;
}

const { person, headingLevel = 3, delay = 0 } = Astro.props;
const Heading = headingLevel === 2 ? 'h2' : 'h3';
---

<a
  class="list-row person-row enter"
  href={`/people/${person.id}/`}
  style={`--enter-delay: ${delay}ms`}
>
  <PlayerAvatar gameId={person.data.gameId} src={person.data.avatar} />
  <div>
    <span class="list-row-index">人物传记</span>
    <Heading class="list-row-title">{person.data.gameId}</Heading>
    <p class="list-row-text">{person.data.role}</p>
    {
      person.data.tags.length > 0 && (
        <div class="chip-row">
          {person.data.tags.map((tag) => (
            <span class="tag-chip">{tag}</span>
          ))}
        </div>
      )
    }
  </div>
  <div class="list-row-meta">
    <span>更新于 {formatDate(person.data.updated)}</span>
    <span class="list-row-cta">
      人物页
      <Icon name="arrow_forward" size={16} />
    </span>
  </div>
</a>
