---
import '../styles/fonts.css';
import '../styles/md3-tokens.css';
import '../styles/base.css';
import TopAppBar from '../components/TopAppBar.astro';
import BottomNav from '../components/BottomNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Icon from '../components/Icon.astro';
import type { NavKey } from '../lib/nav';

interface Props {
  title: string;
  description?: string;
  current?: NavKey;
  /** 错误页等不该被索引的页面 */
  noindex?: boolean;
}

const {
  title,
  description = '氢风（Hydwind）是 Minecraft Java 生存服务器。',
  current = 'home',
  noindex = false,
} = Astro.props;

const siteOrigin = Astro.site ?? 'http://103.236.99.253:62179';
const canonicalURL = new URL(Astro.url.pathname, siteOrigin).href;
const ogImage = new URL('/images/world/hydwind-world-1920.webp', siteOrigin).href;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!--
      首屏/页头品牌字需要的几个子集：氢、风（700-13 / 700-1）和 Rubik 拉丁。
      unicode-range 已经保证不下载用不到的字体；这里只把最先出现的字形提前。
    -->
    <link
      rel="preload"
      href="/fonts/misans/700-13.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/misans/700-1.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/rubik/rubik-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta name="theme-color" content="#f8f9ff" data-theme-color />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="氢风 Hydwind" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1920" />
    <meta property="og:image:height" content="1080" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('hydwind-theme');
          const dark = stored
            ? stored === 'dark'
            : window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.dataset.theme = dark ? 'dark' : 'light';
          // 地址栏颜色和主题在首帧就同步，避免深色用户先看到一条浅色浏览器 chrome。
          document
            .querySelector('meta[data-theme-color]')
            ?.setAttribute('content', dark ? '#0e141c' : '#f8f9ff');
        } catch {
          document.documentElement.dataset.theme = 'light';
        }
      })();

      /*
       * 跨文档换页：
       * - 常驻 chrome 留在 root 快照里，root 本身不做动画，页头/底栏不会闪、不会消失；
       * - 只有 main 和当前项胶囊各自过渡；
       * - 这里把「过渡何时结束」变成 promise，动效层等它跑完再接管，
       *   否则 GSAP 的 opacity: 0 会被截进新页面快照。
       */
      window.__hwViewTransition = new Promise((resolve) => {
        let settled = false;

        const finish = (transition) => {
          if (settled) return;
          settled = true;
          resolve(transition ?? null);
        };

        window.addEventListener(
          'pagereveal',
          (event) => {
            if (!event.viewTransition) return finish(null);

            const root = document.documentElement;
            root.dataset.vt = 'cross';
            window.hydwindViewTransition = event.viewTransition;

            event.viewTransition.finished
              .then(() => {
                root.dataset.vt = 'settled';
              })
              .catch(() => {
                root.dataset.vt = 'settled';
              })
              .finally(() => finish(event.viewTransition));
          },
          { once: true }
        );

        // 直接打开、bfcache 恢复、浏览器不支持过渡：load 后放行动效层
        window.addEventListener(
          'load',
          () => {
            setTimeout(() => finish(null), 0);
          },
          { once: true }
        );

        // 兜底：任何异常情况下都不让动效层永远等下去
        setTimeout(() => finish(null), 2000);
      });

      // 动效层整体没跑起来（脚本被阻断 / bundle 失败）时，
      // 别把 [data-reveal] 永久留在 opacity: 0。没有 JS 的情况由下面的 noscript 兜底。
      window.addEventListener(
        'load',
        () => {
          setTimeout(() => {
            if (document.documentElement.classList.contains('hw-motion')) return;
            document
              .querySelectorAll('[data-reveal]')
              .forEach((element) => element.classList.add('is-revealed'));
          }, 2500);
        },
        { once: true }
      );
    </script>
    <noscript>
      <style>
        [data-reveal] {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>
  </head>
  <body data-page={current}>
    <a class="skip-link" href="#main">跳到主要内容</a>
    <div class="scroll-progress" data-scroll-progress aria-hidden="true"></div>
    <div class="nav-progress" data-nav-progress aria-hidden="true"></div>
    <TopAppBar current={current} />
    <BottomNav current={current} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />

    <div
      class="snackbar"
      data-snackbar
      role="status"
      aria-live="polite"
      aria-atomic="true"
      aria-hidden="true"
    >
      <Icon name="check" size={20} />
      <span data-snackbar-text></span>
      <button class="snackbar-action" type="button" data-snackbar-close>关闭</button>
    </div>

    <script>
      import { initMotion } from '../scripts/motion';
      import { initNavigation } from '../scripts/navigation';

      const root = document.documentElement;
      const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
      const themeMeta = document.querySelector<HTMLMetaElement>('[data-theme-color]');

      const syncTheme = (theme: 'light' | 'dark') => {
        root.dataset.theme = theme;
        themeMeta?.setAttribute('content', theme === 'dark' ? '#0e141c' : '#f8f9ff');
        toggle?.setAttribute(
          'aria-label',
          theme === 'dark' ? '切换到浅色模式' : '切换到深色模式'
        );
      };

      const setTheme = (theme: 'light' | 'dark') => {
        // 主题切换只该发生一帧：停掉颜色过渡，避免「浅色底 + 深色页头」的混合帧
        root.dataset.themeSwitching = '';
        syncTheme(theme);
        try {
          localStorage.setItem('hydwind-theme', theme);
        } catch {
          /* storage can be unavailable in private modes */
        }
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            delete root.dataset.themeSwitching;
          });
        });
      };

      syncTheme(root.dataset.theme === 'dark' ? 'dark' : 'light');

      toggle?.addEventListener('click', () => {
        setTheme(root.dataset.theme === 'dark' ? 'light' : 'dark');
      });

      const snackbar = document.querySelector<HTMLElement>('[data-snackbar]');
      const snackbarText = document.querySelector<HTMLElement>('[data-snackbar-text]');
      let snackbarTimer = 0;

      const hideSnackbar = () => {
        snackbar?.classList.remove('is-open');
        snackbar?.setAttribute('aria-hidden', 'true');
      };

      const showSnackbar = (message: string) => {
        if (!snackbar || !snackbarText) return;
        snackbarText.textContent = message;
        snackbar.classList.add('is-open');
        snackbar.setAttribute('aria-hidden', 'false');
        window.clearTimeout(snackbarTimer);
        snackbarTimer = window.setTimeout(hideSnackbar, 3200);
      };

      document
        .querySelector('[data-snackbar-close]')
        ?.addEventListener('click', hideSnackbar);

      type ToastHost = Window & { hydwindToast?: (message: string) => void };
      const toastHost = window as ToastHost;

      document.querySelectorAll<HTMLElement>('[data-copy]').forEach((button) => {
        button.addEventListener('click', async () => {
          const value = button.dataset.copy;
          if (!value) return;

          try {
            await navigator.clipboard.writeText(value);
          } catch {
            try {
              const area = document.createElement('textarea');
              area.value = value;
              area.style.position = 'fixed';
              area.style.opacity = '0';
              document.body.appendChild(area);
              area.select();
              const copied = document.execCommand('copy');
              area.remove();
              if (!copied) throw new Error('copy failed');
            } catch {
              toastHost.hydwindToast?.(`复制失败，请手动选择 ${value}`);
              return;
            }
          }

          toastHost.hydwindToast?.(`已复制 ${value}`);
        });
      });

      toastHost.hydwindToast = showSnackbar;

      // 动效统一交给 src/scripts/motion.ts：CSS 过渡是降级方案，GSAP 是主路径。
      // 换页过渡还在跑的时候先等一等：GSAP 会把元素压到 opacity: 0，
      // 而浏览器恰好在此时截新页面快照，截到的就是一张空页。
      type VTWindow = Window & { __hwViewTransition?: Promise<unknown> };
      const motionGate = (window as VTWindow).__hwViewTransition ?? Promise.resolve();

      void motionGate.then(() => {
        initMotion();
      });

      // 站内跳转的进度条与按下反馈（预取在 astro.config.mjs 里配）
      initNavigation();
    </script>
  </body>
</html>
