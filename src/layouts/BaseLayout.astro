---
import '../styles/fonts.css';
import '../styles/md3-tokens.css';
import '../styles/base.css';
import TopAppBar from '../components/TopAppBar.astro';
import BottomNav from '../components/BottomNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Icon from '../components/Icon.astro';
import type { NavKey } from '../lib/nav';

interface Props {
  title: string;
  description?: string;
  current?: NavKey;
}

const {
  title,
  description = '氢风（Hydwind）是 Minecraft Java 生存服务器。',
  current = 'home',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://hydwind.lovie.me').href;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#f8f9ff" data-theme-color />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="氢风 Hydwind" />
    <meta property="og:locale" content="zh_CN" />
    <meta name="twitter:card" content="summary" />
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('hydwind-theme');
          const dark = stored
            ? stored === 'dark'
            : window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.dataset.theme = dark ? 'dark' : 'light';
        } catch {
          document.documentElement.dataset.theme = 'light';
        }
      })();

      // 跨文档换页过渡马上要开始时告诉页面两件事：
      // 1. `data-vt="cross"` —— 关掉 .enter 进场动画，别让新快照截到 opacity: 0 的空页
      // 2. 把过渡对象挂到 window —— 动效层等它跑完再接管，否则 GSAP 的 opacity: 0 也一样会被截进快照
      // 必须写在 head 里：pagereveal 在文档解析完、首次渲染前就触发了。
      window.addEventListener('pagereveal', (event) => {
        if (!event.viewTransition) return;
        document.documentElement.dataset.vt = 'cross';
        window.hydwindViewTransition = event.viewTransition;
      });
    </script>
  </head>
  <body data-page={current}>
    <a class="skip-link" href="#main">跳到主要内容</a>
    <div class="scroll-progress" data-scroll-progress aria-hidden="true"></div>
    <div class="nav-progress" data-nav-progress aria-hidden="true"></div>
    <TopAppBar current={current} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
    <BottomNav current={current} />

    <div
      class="snackbar"
      data-snackbar
      role="status"
      aria-live="polite"
      aria-atomic="true"
      aria-hidden="true"
    >
      <Icon name="check" size={20} />
      <span data-snackbar-text></span>
      <button class="snackbar-action" type="button" data-snackbar-close>关闭</button>
    </div>

    <script>
      import { initMotion } from '../scripts/motion';
      import { initNavigation } from '../scripts/navigation';

      const root = document.documentElement;
      const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
      const themeMeta = document.querySelector<HTMLMetaElement>('[data-theme-color]');

      const syncTheme = (theme: 'light' | 'dark') => {
        root.dataset.theme = theme;
        themeMeta?.setAttribute('content', theme === 'dark' ? '#0e141c' : '#f8f9ff');
        toggle?.setAttribute(
          'aria-label',
          theme === 'dark' ? '切换到浅色模式' : '切换到深色模式'
        );
      };

      const setTheme = (theme: 'light' | 'dark') => {
        syncTheme(theme);
        try {
          localStorage.setItem('hydwind-theme', theme);
        } catch {
          /* storage can be unavailable in private modes */
        }
      };

      syncTheme(root.dataset.theme === 'dark' ? 'dark' : 'light');

      toggle?.addEventListener('click', () => {
        setTheme(root.dataset.theme === 'dark' ? 'light' : 'dark');
      });

      const snackbar = document.querySelector<HTMLElement>('[data-snackbar]');
      const snackbarText = document.querySelector<HTMLElement>('[data-snackbar-text]');
      let snackbarTimer = 0;

      const hideSnackbar = () => {
        snackbar?.classList.remove('is-open');
        snackbar?.setAttribute('aria-hidden', 'true');
      };

      const showSnackbar = (message: string) => {
        if (!snackbar || !snackbarText) return;
        snackbarText.textContent = message;
        snackbar.classList.add('is-open');
        snackbar.setAttribute('aria-hidden', 'false');
        window.clearTimeout(snackbarTimer);
        snackbarTimer = window.setTimeout(hideSnackbar, 3200);
      };

      document
        .querySelector('[data-snackbar-close]')
        ?.addEventListener('click', hideSnackbar);

      type ToastHost = Window & { hydwindToast?: (message: string) => void };
      const toastHost = window as ToastHost;

      document.querySelectorAll<HTMLElement>('[data-copy]').forEach((button) => {
        button.addEventListener('click', async () => {
          const value = button.dataset.copy;
          if (!value) return;

          try {
            await navigator.clipboard.writeText(value);
          } catch {
            try {
              const area = document.createElement('textarea');
              area.value = value;
              area.style.position = 'fixed';
              area.style.opacity = '0';
              document.body.appendChild(area);
              area.select();
              const copied = document.execCommand('copy');
              area.remove();
              if (!copied) throw new Error('copy failed');
            } catch {
              toastHost.hydwindToast?.(`复制失败，请手动选择 ${value}`);
              return;
            }
          }

          toastHost.hydwindToast?.(`已复制 ${value}`);
        });
      });

      toastHost.hydwindToast = showSnackbar;

      // 动效统一交给 src/scripts/motion.ts：CSS 过渡是降级方案，GSAP 是主路径。
      // 换页过渡还在跑的时候先等一等：GSAP 会把元素压到 opacity: 0，
      // 而浏览器恰好在此时截新页面快照，截到的就是一张空页。
      const pendingTransition = (
        window as Window & { hydwindViewTransition?: ViewTransition }
      ).hydwindViewTransition;

      const motionGate = pendingTransition
        ? pendingTransition.finished.catch(() => undefined)
        : Promise.resolve();

      void motionGate.then(() => initMotion());
      // 站内跳转的进度条与按下反馈（预取在 astro.config.mjs 里配）
      initNavigation();
    </script>
  </body>
</html>
