---
// 内容页在构建期渲染成静态 HTML，只有 /api/* 走服务端
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import ServerInfo from '../components/ServerInfo.astro';
import PersonCard from '../components/PersonCard.astro';
import GuideSteps from '../components/GuideSteps.astro';
import { formatDate } from '../lib/format';
import {
  JOIN_GUIDE_ID,
  getJoinGuide,
  getPublishedPeople,
  getSite,
} from '../lib/content';

const site = await getSite();
const people = await getPublishedPeople();
const joinGuide = await getJoinGuide();
const join = joinGuide.data;

// 三张卡都只复述站点信息里已有的确认事实，不额外造设定
const facts = [
  {
    icon: 'terminal',
    title: '客户端要求',
    text: `Java 版 ${site.clientVersions}，${site.clientRequirement}。`,
  },
  {
    icon: 'globe',
    title: '验证方式',
    text: `${site.authentication}。`,
  },
  {
    icon: 'badge',
    title: '收费与进服限制',
    text: `${site.pricing}；${site.joinLimit}。`,
  },
];

const description = `${site.name}（Hydwind）是原版与插件生存的 Minecraft Java 服务器。地址 ${site.address}，支持 Java 版 ${site.clientVersions}，${site.authentication}、${site.pricing}。`;
---

<BaseLayout
  title="氢风 Hydwind · Minecraft Java 生存服务器"
  description={description}
  current="home"
>
  <section class="hero-wrap hw-shell">
    <div class="hero-card hero-card--split enter">
      <div class="hero-copy">
        <span class="tag-chip hero-badge">
          <span class="hero-dot" aria-hidden="true"></span>
          Minecraft Java 生存服
        </span>

        <h1 class="hero-title">氢风</h1>
        <p class="hero-en">HYDWIND</p>
        <p class="hero-lead">{site.tagline}</p>

        <div class="hero-actions">
          <button
            class="filled-button"
            type="button"
            data-copy={site.address}
            aria-label={`复制服务器地址 ${site.address}`}
          >
            <Icon name="copy" size={18} />
            复制服务器地址
            <code>{site.address}</code>
          </button>
          <a
            class="outlined-button"
            href={`/guides/${JOIN_GUIDE_ID}/`}
          >
            第一次进服
            <Icon name="arrow_forward" size={18} />
          </a>
        </div>

        <div class="hero-tags">
          <span class="assist-chip hero-chip">Java 版 {site.clientVersions}</span>
          <span class="assist-chip hero-chip">{site.pricing}</span>
          <span class="assist-chip hero-chip">不需要装模组</span>
        </div>
      </div>

      <div class="hero-visual">
        <div class="server-card">
          <div class="server-top">
            <span
              class="server-status"
              data-server-status
              data-state="checking"
              data-host={site.host}
              data-port={site.port}
              role="status"
              aria-live="polite"
              aria-atomic="true"
              aria-busy="true"
            >
              <span class="status-dot" aria-hidden="true"></span>
              <span data-server-status-text>正在查询服务器状态</span>
            </span>
            <span class="server-code">JAVA / SURVIVAL</span>
          </div>

          <div class="server-address">
            <span class="server-label">服务器地址</span>
            <div class="address-row">
              <code>{site.address}</code>
              <button
                class="icon-button server-copy"
                type="button"
                data-copy={site.address}
                aria-label={`复制服务器地址 ${site.address}`}
              >
                <Icon name="copy" size={20} />
              </button>
            </div>
          </div>

          <dl class="server-meta">
            <div>
              <dt>客户端</dt>
              <dd>Java {site.clientVersions}</dd>
            </div>
            <div>
              <dt>验证</dt>
              <dd>{site.authentication}</dd>
            </div>
            <div>
              <dt>收费</dt>
              <dd>{site.pricing}</dd>
            </div>
            <div>
              <dt>白名单</dt>
              <dd>无</dd>
            </div>
          </dl>

          <button
            class="text-button status-refresh"
            type="button"
            data-server-refresh
            disabled
          >
            <Icon name="refresh" size={16} />
            重新查询状态
          </button>
        </div>
      </div>
    </div>
  </section>

  <section class="facts hw-shell" aria-labelledby="facts-title">
    <header class="section-heading" data-reveal>
      <div>
        <p class="hw-eyebrow">先知道这三件事</p>
        <h2 id="facts-title">进服前不用准备太多</h2>
      </div>
      <a href={`/guides/${JOIN_GUIDE_ID}/`}>
        看完整指南
        <Icon name="arrow_forward" size={16} />
      </a>
    </header>

    <div class="content-grid">
      {
        facts.map((fact, index) => (
          <article
            class="panel fact-card"
            data-reveal
            style={`--reveal-delay: ${index * 80}ms`}
          >
            <span class="icon-tile">
              <Icon name={fact.icon} size={22} />
            </span>
            <h3 class="fact-title">{fact.title}</h3>
            <p class="fact-text">{fact.text}</p>
          </article>
        ))
      }
    </div>
  </section>

  <div class="hw-shell server-info-wrap">
    <ServerInfo site={site} />
  </div>

  {
    people.length > 0 && (
      <section class="people-section hw-shell" aria-labelledby="people-title">
        <header class="section-heading" data-reveal>
          <div>
            <p class="hw-eyebrow">人物传记</p>
            <h2 id="people-title">服务器里真实存在的人</h2>
          </div>
          <a href="/people/">
            查看全部
            <Icon name="arrow_forward" size={16} />
          </a>
        </header>

        <div class="content-grid">
          {people.map((person, index) => (
            <PersonCard
              person={person}
              headingLevel={3}
              delay={80 + index * 60}
            />
          ))}
        </div>
      </section>
    )
  }

  <section class="join-wrap hw-shell" id="join" aria-labelledby="join-title">
    <div class="join-card" data-reveal>
      <div class="join-orbit" aria-hidden="true"></div>

      <div class="join-copy">
        <p class="hw-eyebrow join-eyebrow">第一次来</p>
        <h2 id="join-title">{join.title}</h2>
        <p>{join.summary}</p>

        <div class="join-address">
          <span class="server-label">服务器地址</span>
          <code>{site.address}</code>
        </div>

        <div class="join-actions">
          <button
            class="filled-button"
            type="button"
            data-copy={site.address}
            aria-label={`复制服务器地址 ${site.address}`}
          >
            <Icon name="copy" size={18} />
            复制地址
          </button>
          <button
            class="outlined-button"
            type="button"
            data-copy={site.qqGroup}
            aria-label={`复制 QQ 群号 ${site.qqGroup}`}
          >
            <Icon name="copy" size={18} />
            复制 QQ 群号 {site.qqGroup}
          </button>
          <a class="text-button" href={`/guides/${JOIN_GUIDE_ID}/`}>
            阅读完整指南
            <Icon name="arrow_forward" size={18} />
          </a>
        </div>

        <div class="notice join-notice">
          <span>
            <strong>测试期提示：</strong>{site.testingNotice}。
            <strong>进服限制：</strong>{site.joinLimit}；最新安排以官方 QQ 群{' '}
            {site.qqGroup} 为准。
          </span>
        </div>
      </div>

      <GuideSteps steps={join.steps} variant="join" />

      <p class="join-updated">
        指南更新于 {formatDate(join.updated)} · 服务器信息更新于{' '}
        {formatDate(site.updated)}
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  type ServerState = 'checking' | 'online' | 'offline' | 'error';

  const labels: Record<ServerState, string> = {
    checking: '正在查询服务器状态',
    online: '在线',
    offline: '离线',
    error: '查询失败',
  };

  const status = document.querySelector<HTMLElement>('[data-server-status]');
  const statusText = status?.querySelector<HTMLElement>('[data-server-status-text]');
  const refresh = document.querySelector<HTMLButtonElement>('[data-server-refresh]');
  const host = status?.dataset.host;
  const port = status?.dataset.port;
  let running = false;

  const render = (state: ServerState) => {
    if (!status) return;
    status.dataset.state = state;
    status.setAttribute('aria-busy', state === 'checking' ? 'true' : 'false');
    if (statusText) statusText.textContent = labels[state];
    refresh?.toggleAttribute('disabled', state === 'checking');
  };

  const getJson = async (url: string): Promise<{ online?: unknown }> => {
    const controller = new AbortController();
    const timer = window.setTimeout(() => controller.abort(), 8000);
    try {
      const response = await fetch(url, {
        signal: controller.signal,
        cache: 'no-store',
        headers: { Accept: 'application/json' },
      });
      if (!response.ok) throw new Error(`HTTP ${response.status}`);
      return (await response.json()) as { online?: unknown };
    } finally {
      window.clearTimeout(timer);
    }
  };

  const check = async () => {
    if (running) return;
    if (!host || !port) {
      render('error');
      return;
    }

    running = true;
    render('checking');

    try {
      let online: boolean | null = null;

      try {
        const primary = await getJson(
          `https://api.mcsrvstat.us/3/${host}:${port}`
        );
        if (typeof primary.online === 'boolean') online = primary.online;
      } catch {
        /* 主数据源失败时回退到 mcstatus.io */
      }

      if (online === null) {
        const fallback = await getJson(
          `https://api.mcstatus.io/v2/status/java/${host}:${port}`
        );
        if (typeof fallback.online === 'boolean') online = fallback.online;
      }

      render(online === null ? 'error' : online ? 'online' : 'offline');
    } catch {
      render('error');
    } finally {
      running = false;
    }
  };

  refresh?.addEventListener('click', () => {
    void check();
  });

  void check();
</script>

<style>
  .hero-wrap {
    padding-top: clamp(16px, 2.5vw, 28px);
  }


  .hero-badge {
    gap: 8px;
    background: var(--md-sys-color-surface-container-lowest);
    color: var(--md-sys-color-primary);
  }

  .hero-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--md-sys-color-primary);
  }

  .hero-title {
    margin-top: 20px;
    font-size: clamp(2.9rem, 6.4vw, 4.2rem);
    line-height: 1.02;
    letter-spacing: -0.04em;
    color: var(--md-sys-color-on-primary-container);
  }



  .server-card {
    padding: clamp(20px, 2.6vw, 26px);
    border-radius: var(--md-sys-shape-corner-large);
    background: var(--md-sys-color-surface-container-lowest);
    color: var(--md-sys-color-on-surface);
    box-shadow: var(--hw-elevation-raised);
  }

  .server-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .server-status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--md-sys-color-on-surface-variant);
    font-size: 0.8125rem;
    font-weight: 600;
  }

  .server-status[data-state='online'] {
    color: var(--md-sys-color-primary);
  }

  .server-status[data-state='offline'] {
    color: var(--md-sys-color-on-surface-variant);
  }

  .server-status[data-state='error'] {
    color: var(--md-sys-color-error);
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: currentColor;
  }

  .server-status[data-state='checking'] .status-dot {
    animation: status-pulse 1.2s var(--md-sys-motion-easing-standard) infinite;
  }

  @keyframes status-pulse {
    0%,
    100% {
      opacity: 0.35;
    }

    50% {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .server-status[data-state='checking'] .status-dot {
      animation: none;
    }
  }

  .server-code {
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    color: var(--md-sys-color-on-surface-variant);
  }

  .server-address {
    margin-top: 26px;
  }

  .server-label {
    display: block;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--md-sys-color-on-surface-variant);
  }

  .address-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 4px;
  }

  .address-row code {
    font-size: clamp(1.05rem, 1.8vw, 1.3rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    word-break: break-all;
  }

  .server-copy {
    flex: 0 0 auto;
    color: var(--md-sys-color-primary);
  }

  .server-meta {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px 16px;
    margin-top: 22px;
    padding-top: 16px;
    border-top: 1px solid var(--md-sys-color-outline-variant);
  }

  .server-meta dt {
    font-size: 0.6875rem;
    color: var(--md-sys-color-on-surface-variant);
  }

  .server-meta dd {
    margin-top: 3px;
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.45;
  }

  .status-refresh {
    min-height: 36px;
    margin-top: 12px;
    margin-left: -12px;
    color: var(--md-sys-color-primary);
    font-size: var(--md-sys-typescale-label-medium-size);
  }

  .status-refresh:disabled {
    opacity: 0.5;
    cursor: default;
  }

  .facts {
    padding-top: clamp(48px, 7vw, 80px);
  }

  .fact-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    box-shadow: none;
  }

  .fact-title {
    margin-top: 4px;
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.45;
  }

  .fact-text {
    color: var(--md-sys-color-on-surface-variant);
    font-size: var(--md-sys-typescale-body-medium-size);
    line-height: 1.75;
  }

  .server-info-wrap {
    padding-top: clamp(24px, 3.5vw, 36px);
  }

  .people-section {
    padding-top: clamp(48px, 7vw, 80px);
  }

  .join-wrap {
    padding-top: clamp(48px, 7vw, 80px);
  }

  .join-card {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(28px, 5vw, 64px);
    overflow: hidden;
    padding: clamp(24px, 4.5vw, 56px);
    border-radius: var(--md-sys-shape-corner-extra-large);
    background: var(--md-sys-color-primary-container);
    color: var(--md-sys-color-on-primary-container);
  }

  .join-orbit {
    position: absolute;
    right: -12%;
    bottom: -55%;
    width: clamp(320px, 42vw, 560px);
    aspect-ratio: 1;
    border: 1px solid
      color-mix(in srgb, var(--md-sys-color-on-primary-container) 14%, transparent);
    border-radius: 50%;
    pointer-events: none;
  }

  .join-copy,
  :global(.join-steps),
  .join-updated {
    position: relative;
    z-index: 1;
  }

  .join-eyebrow {
    color: var(--md-sys-color-on-primary-container);
  }

  .join-copy h2 {
    max-width: 12em;
    margin-top: 10px;
  }

  .join-copy > p:not(.hw-eyebrow) {
    max-width: 32em;
    margin-top: 12px;
    color: var(--md-sys-color-on-primary-container);
    line-height: 1.75;
  }

  .join-address {
    display: inline-flex;
    flex-direction: column;
    gap: 4px;
    margin-top: 22px;
    padding: 12px 16px;
    border-radius: var(--md-sys-shape-corner-medium);
    background: var(--md-sys-color-surface);
    color: var(--md-sys-color-primary);
  }

  .join-address .server-label {
    color: var(--md-sys-color-on-surface-variant);
  }

  .join-address code {
    color: var(--md-sys-color-primary);
    font-size: 1rem;
    font-weight: 600;
    word-break: break-all;
  }

  .join-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-top: 20px;
  }





  .join-updated {
    grid-column: 1 / -1;
    margin-top: 8px;
    color: color-mix(
      in srgb,
      var(--md-sys-color-on-primary-container) 78%,
      transparent
    );
    font-size: var(--md-sys-typescale-label-small-size);
  }

  @media (max-width: 839px) {
    .join-card {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 599px) {
    .hero-actions {
      align-items: stretch;
      flex-direction: column;
    }

    .hero-actions .filled-button,
    .hero-actions .outlined-button {
      width: 100%;
    }

    .server-card {
      padding: 20px;
    }

    .server-meta {
      grid-template-columns: minmax(0, 1fr);
    }

    .join-actions {
      align-items: stretch;
      flex-direction: column;
    }

    .join-actions .filled-button,
    .join-actions .outlined-button {
      width: 100%;
    }
  }
</style>
