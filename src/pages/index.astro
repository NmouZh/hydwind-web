---
// 内容页在构建期渲染成静态 HTML，只有 /api/* 走服务端
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import PersonCard from '../components/PersonCard.astro';
import GuideSteps from '../components/GuideSteps.astro';
import { formatDate } from '../lib/format';
import {
  JOIN_GUIDE_ID,
  getJoinGuide,
  getPublishedPeople,
  getSite,
} from '../lib/content';

const site = await getSite();
const people = await getPublishedPeople();
const joinGuide = await getJoinGuide();
const join = joinGuide.data;

// 已在人物页有本地头像的玩家直接用本地图；其余在线玩家走 /api/avatar 代理
const avatarByGameId = Object.fromEntries(
  people.map((person) => [person.data.gameId.toLowerCase(), person.data.avatar])
);

// 三条都只复述站点信息里已有的确认事实，不额外造设定
const facts = [
  {
    label: '客户端',
    value: `Java ${site.clientVersions}`,
    text: `${site.clientRequirement}。`,
  },
  {
    label: '验证与白名单',
    value: '离线 · 无白名单',
    text: `${site.authentication}；${site.joinLimit}。`,
  },
  {
    label: '收费与测试期',
    value: site.pricing,
    text: `${site.testingNotice}。`,
  },
];

const description = `${site.name}（Hydwind）是原版与插件生存的 Minecraft Java 服务器。地址 ${site.address}，支持 Java 版 ${site.clientVersions}，${site.authentication}、${site.pricing}。`;
---

<BaseLayout
  title="氢风 Hydwind · Minecraft Java 生存服务器"
  description={description}
  current="home"
>
  <section class="hero" data-hero aria-labelledby="hero-title">
    <!-- 世界插画来自工作区 hydwind-promo 的 WorldLandscape 场景（第一方素材），已转为 webp -->
    <div class="hero-bg" aria-hidden="true">
      <div class="hero-bg-media" data-parallax="0.05">
        <img
          src="/images/world/hydwind-world-1920.webp"
          srcset="/images/world/hydwind-world-960.webp 960w, /images/world/hydwind-world-1920.webp 1920w"
          sizes="100vw"
          width="1920"
          height="1080"
          alt=""
          fetchpriority="high"
          decoding="async"
        />
      </div>
      <div class="hero-scrim"></div>
    </div>

    <div class="hw-shell hero-inner">
      <div class="hero-main enter">
        <div class="hero-title-row">
          <h1 id="hero-title" class="hero-title" data-split>氢风</h1>
          <p class="hero-en">HYDWIND</p>
        </div>

        <p class="hero-lead">{site.tagline}</p>

        <div class="hero-actions">
          <button
            class="filled-button"
            type="button"
            data-magnetic
            data-copy={site.address}
            aria-label={`复制服务器地址 ${site.address}`}
          >
            <Icon name="copy" size={18} />
            复制服务器地址
          </button>
          <a class="text-button" href={`/guides/${JOIN_GUIDE_ID}/`}>
            第一次进服
            <Icon name="arrow_forward" size={18} />
          </a>
          <a class="text-button" href="/gate/">
            已有账号？获取登录码
            <Icon name="key" size={18} />
          </a>
        </div>
      </div>

      <aside
        class="hero-server enter"
        style="--enter-delay: 140ms"
        aria-label="服务器地址与状态"
      >
        <div class="server-card">
          <div class="server-top">
            <span
              class="server-status"
              data-server-status
              data-state="checking"
              data-host={site.host}
              data-port={site.port}
              role="status"
              aria-live="polite"
              aria-atomic="true"
              aria-busy="true"
            >
              <span class="status-dot" aria-hidden="true"></span>
              <span data-server-status-text>正在查询服务器状态</span>
            </span>
            <span class="server-code">Java 版 · 生存</span>
          </div>

          <div class="server-address">
            <span class="server-label">服务器地址</span>
            <div class="address-row">
              <code>{site.address}</code>
              <button
                class="icon-button server-copy"
                type="button"
                data-copy={site.address}
                aria-label={`复制服务器地址 ${site.address}`}
              >
                <Icon name="copy" size={20} />
              </button>
            </div>
          </div>

          <dl class="server-meta">
            <div>
              <dt>客户端</dt>
              <dd>Java {site.clientVersions}</dd>
            </div>
            <div>
              <dt>验证</dt>
              <dd>离线验证</dd>
            </div>
            <div>
              <dt>收费</dt>
              <dd>{site.pricing}</dd>
            </div>
            <div>
              <dt>白名单</dt>
              <dd>无</dd>
            </div>
          </dl>

          <button
            class="text-button status-refresh"
            type="button"
            data-server-refresh
            disabled
          >
            <Icon name="refresh" size={16} />
            重新查询状态
          </button>
        </div>
      </aside>
    </div>
  </section>

  <section class="hw-shell hw-grid facts" aria-labelledby="facts-title">
    <header class="hw-span-4 facts-head" data-reveal>
      <p class="hw-eyebrow">进服之前</p>
      <h2 id="facts-title">三件要先确认的事</h2>
    </header>

    <dl class="hw-span-8 fact-strip">
      {
        facts.map((fact, index) => (
          <div
            class="fact-item"
            data-reveal
            style={`--reveal-delay: ${index * 80}ms`}
          >
            <dt class="fact-label">{fact.label}</dt>
            <dd class="fact-value">{fact.value}</dd>
            <dd class="fact-text">{fact.text}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="hw-shell section online-section" aria-labelledby="online-title">
    <header class="section-heading" data-reveal>
      <div>
        <p class="hw-eyebrow">Online</p>
        <h2 id="online-title">现在在线</h2>
        <p class="online-sub">服务器上正在玩的人。状态和名单每 60 秒自动刷新。</p>
      </div>
      <div class="online-tools">
        <span class="online-count" data-online-count aria-live="polite">-- / --</span>
        <button
          class="icon-button online-refresh"
          type="button"
          data-online-refresh
          aria-label="刷新在线玩家"
          disabled
        >
          <Icon name="refresh" size={18} />
        </button>
      </div>
    </header>

    <div
      class="online-body"
      data-online-body
      data-avatars={JSON.stringify(avatarByGameId)}
      aria-busy="true"
    >
      <p class="online-message" data-online-message role="status" aria-live="polite">
        正在查询在线玩家…
      </p>
      <div class="online-grid" data-online-grid hidden></div>
      <noscript>
        <p class="online-message">实时在线状态需要 JavaScript；也可以直接进服，或在 QQ 群问一声。</p>
      </noscript>
    </div>
  </section>

  {
    people.length > 0 && (
      <section class="hw-shell section people-section" aria-labelledby="people-title">
        <header class="section-heading" data-reveal>
          <div>
            <p class="hw-eyebrow">人物传记</p>
            <h2 id="people-title">服务器里真实存在的人</h2>
          </div>
          <a href="/people/">
            查看全部
            <Icon name="arrow_forward" size={16} />
          </a>
        </header>

        <div class="people-layout">
          <p class="people-statement" data-reveal>
            <span>服务器不只是一串地址，</span>
            <span>还有在这里留下名字的人。</span>
          </p>
          <div class="list-rows people-list">
            {people.map((person, index) => (
              <PersonCard
                person={person}
                headingLevel={3}
                delay={80 + index * 60}
                showKicker={false}
              />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="join-band" id="join" aria-labelledby="join-title">
    <div class="hw-shell join-inner">
      <header class="join-head" data-reveal>
        <p class="hw-eyebrow join-eyebrow">开始</p>
        <h2 id="join-title">{join.title}</h2>
        <p class="join-summary">{join.summary}</p>
      </header>

      <div class="hw-grid join-grid">
        <div class="hw-span-6 join-main" data-reveal>
          <div class="join-address">
            <span class="server-label">服务器地址</span>
            <code>{site.address}</code>
          </div>

          <div class="join-actions">
            <button
              class="filled-button"
              type="button"
              data-copy={site.address}
              aria-label={`复制服务器地址 ${site.address}`}
            >
              <Icon name="copy" size={18} />
              复制服务器地址
            </button>
            <button
              class="outlined-button"
              type="button"
              data-copy={site.qqGroup}
              aria-label={`复制 QQ 群号 ${site.qqGroup}`}
            >
              <Icon name="copy" size={18} />
              QQ 群 {site.qqGroup}
            </button>
          </div>

          <div class="notice join-notice">
            <span>
              <strong>测试期提示：</strong>{site.testingNotice}。
              <strong>进服限制：</strong>{site.joinLimit}；最新安排以官方 QQ 群{' '}
              {site.qqGroup} 为准。
            </span>
          </div>
        </div>

        <div class="hw-span-6 join-steps-wrap" data-reveal style="--reveal-delay: 80ms">
          <p class="join-steps-label hw-label">四个步骤</p>
          <GuideSteps steps={join.steps} variant="join" />
          <a class="text-button join-more" href={`/guides/${JOIN_GUIDE_ID}/`}>
            阅读完整指南
            <Icon name="arrow_forward" size={18} />
          </a>
        </div>
      </div>

      <p class="join-updated">
        指南更新于 {formatDate(join.updated)} · 服务器信息更新于{' '}
        {formatDate(site.updated)}
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  type ServerState = 'checking' | 'online' | 'offline' | 'error';

  interface StatusPayload {
    online?: boolean;
    players?: { online?: number; max?: number; names?: string[] };
  }

  const labels: Record<ServerState, string> = {
    checking: '正在查询服务器状态',
    online: '在线',
    offline: '离线',
    error: '查询失败',
  };

  const status = document.querySelector<HTMLElement>('[data-server-status]');
  const statusText = status?.querySelector<HTMLElement>('[data-server-status-text]');
  const refresh = document.querySelector<HTMLButtonElement>('[data-server-refresh]');
  const onlineBody = document.querySelector<HTMLElement>('[data-online-body]');
  const onlineMessage = document.querySelector<HTMLElement>('[data-online-message]');
  const onlineGrid = document.querySelector<HTMLElement>('[data-online-grid]');
  const onlineCount = document.querySelector<HTMLElement>('[data-online-count]');
  const onlineRefresh = document.querySelector<HTMLButtonElement>('[data-online-refresh]');

  const avatarByGameId: Record<string, string> = (() => {
    try {
      return JSON.parse(onlineBody?.dataset.avatars ?? '{}') as Record<string, string>;
    } catch {
      return {};
    }
  })();

  const avatarSrc = (name: string): string =>
    avatarByGameId[name.toLowerCase()] ?? `/api/avatar/${encodeURIComponent(name)}`;

  const host = status?.dataset.host;
  const port = status?.dataset.port;
  let running = false;

  const render = (state: ServerState) => {
    if (!status) return;
    status.dataset.state = state;
    status.setAttribute('aria-busy', state === 'checking' ? 'true' : 'false');
    if (statusText) statusText.textContent = labels[state];
    refresh?.toggleAttribute('disabled', state === 'checking');
    onlineRefresh?.toggleAttribute('disabled', state === 'checking');
  };

  const setCount = (count: string) => {
    if (onlineCount) onlineCount.textContent = count;
  };

  const showMessage = (message: string) => {
    onlineBody?.setAttribute('aria-busy', 'false');
    if (onlineMessage) {
      onlineMessage.textContent = message;
      onlineMessage.hidden = false;
    }
    if (onlineGrid) {
      onlineGrid.hidden = true;
      onlineGrid.replaceChildren();
    }
  };

  const showPlayers = (names: string[]) => {
    if (!onlineGrid) return;
    onlineBody?.setAttribute('aria-busy', 'false');
    if (onlineMessage) onlineMessage.hidden = true;

    const fragment = document.createDocumentFragment();
    for (const name of names) {
      const player = document.createElement('span');
      player.className = 'online-player';

      const avatar = document.createElement('img');
      avatar.className = 'online-player-avatar';
      avatar.src = avatarSrc(name);
      avatar.alt = '';
      avatar.width = 30;
      avatar.height = 30;
      avatar.loading = 'lazy';
      avatar.decoding = 'async';
      avatar.addEventListener(
        'error',
        () => {
          avatar.src = '/images/avatars/default-steve.png';
        },
        { once: true }
      );

      const label = document.createElement('span');
      label.className = 'online-player-name';
      label.textContent = name;

      player.append(avatar, label);
      fragment.append(player);
    }

    onlineGrid.replaceChildren(fragment);
    onlineGrid.hidden = false;
  };

  const getJson = async <T,>(url: string): Promise<T> => {
    const controller = new AbortController();
    const timer = window.setTimeout(() => controller.abort(), 8000);
    try {
      const response = await fetch(url, {
        signal: controller.signal,
        cache: 'no-store',
        headers: { Accept: 'application/json' },
      });
      if (!response.ok) throw new Error(`HTTP ${response.status}`);
      return (await response.json()) as T;
    } finally {
      window.clearTimeout(timer);
    }
  };

  const applyStatus = (payload: StatusPayload) => {
    const online = Boolean(payload.online);
    render(online ? 'online' : 'offline');

    if (!online) {
      setCount('-- / --');
      showMessage('服务器离线，恢复后这里会自动刷新。');
      return;
    }

    const current = payload.players?.online ?? 0;
    const max = payload.players?.max ?? 0;
    setCount(max > 0 ? `${current} / ${max}` : String(current));

    const names = (payload.players?.names ?? []).filter(
      (name): name is string => typeof name === 'string' && name.trim().length > 0
    );
    if (names.length > 0) showPlayers(names);
    else showMessage('服务器在线，暂时没有公开的玩家名单。');
  };

  const externalOnline = async (): Promise<boolean | null> => {
    if (!host || !port) return null;

    try {
      const primary = await getJson<{ online?: unknown }>(
        `https://api.mcsrvstat.us/3/${host}:${port}`
      );
      if (typeof primary.online === 'boolean') return primary.online;
    } catch {
      /* 主数据源失败时回退到 mcstatus.io */
    }

    try {
      const fallback = await getJson<{ online?: unknown }>(
        `https://api.mcstatus.io/v2/status/java/${host}:${port}`
      );
      if (typeof fallback.online === 'boolean') return fallback.online;
    } catch {
      /* 两个都挂了就交给上层显示查询失败 */
    }

    return null;
  };

  const check = async () => {
    if (running) return;
    running = true;
    render('checking');
    showMessage('正在查询在线玩家…');
    onlineBody?.setAttribute('aria-busy', 'true');

    try {
      // 优先走站内代理：一次拿到在线状态、人数、名单，也避免浏览器直连第三方被限流
      try {
        const response = await fetch('/api/status', {
          cache: 'no-store',
          headers: { Accept: 'application/json' },
        });
        if (response.ok) {
          applyStatus((await response.json()) as StatusPayload);
          return;
        }
      } catch {
        /* 静态部署 / 接口不可用时回退到公开状态源 */
      }

      const online = await externalOnline();
      if (online === null) {
        render('error');
        setCount('-- / --');
        showMessage('暂时拿不到在线列表，过一会儿再试。');
      } else if (!online) {
        render('offline');
        setCount('-- / --');
        showMessage('服务器离线，恢复后这里会自动刷新。');
      } else {
        render('online');
        setCount('--');
        showMessage('服务器在线，但玩家名单暂时拿不到。');
      }
    } finally {
      running = false;
    }
  };

  refresh?.addEventListener('click', () => {
    void check();
  });

  onlineRefresh?.addEventListener('click', () => {
    void check();
  });

  void check();

  // 页面可见时每分钟刷新一次；后台标签页不占带宽
  window.setInterval(() => {
    if (document.visibilityState === 'visible') void check();
  }, 60_000);
</script>

<style>
  /* —— 首屏：世界插画铺满背景，文字压在底部 —— */
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: end;
    min-height: min(calc(100svh - 64px), 860px);
    overflow: hidden;
    background: var(--md-sys-color-surface);
    color: var(--hw-color-on-media);
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
  }

  .hero-bg-media {
    position: absolute;
    inset: -7% 0;
  }

  .hero-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 45%;
  }

  .hero-scrim {
    position: absolute;
    inset: 0;
    /* 只在文字可能落下的方向压暗；右侧保留太阳和营地的原始亮度 */
    background:
      linear-gradient(
        to top,
        color-mix(in srgb, var(--md-sys-color-scrim) 82%, transparent) 0%,
        color-mix(in srgb, var(--md-sys-color-scrim) 54%, transparent) 42%,
        color-mix(in srgb, var(--md-sys-color-scrim) 20%, transparent) 76%,
        color-mix(in srgb, var(--md-sys-color-scrim) 6%, transparent) 100%
      ),
      linear-gradient(
        to right,
        color-mix(in srgb, var(--md-sys-color-scrim) 38%, transparent) 0%,
        transparent 64%
      );
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(340px, 0.5fr);
    align-items: end;
    gap: var(--hw-space-6) clamp(32px, 6vw, 96px);
    padding-block: clamp(48px, 7vh, 88px);
  }

  .hero-main {
    min-width: 0;
  }

  .hero-title-row {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--hw-space-2) clamp(14px, 2.4vw, 32px);
  }

  .hero-title {
    font-size: clamp(5rem, 17vw, 14rem);
    line-height: 0.86;
    letter-spacing: -0.06em;
    color: var(--hw-color-on-media);
  }

  .hero-en {
    margin-top: 0;
    /* 与标题同色；14px 的小字在手机上不再降到 muted 色 */
    color: var(--hw-color-on-media);
    font-family: var(--hw-font-latin);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.42em;
    text-transform: uppercase;
    opacity: 1;
  }

  .hero-lead {
    max-width: 34ch;
    margin-top: var(--hw-space-5);
    color: var(--hw-color-on-media-muted);
    font-size: 1.0625rem;
    line-height: 1.75;
  }

  .hero-actions {
    margin-top: var(--hw-space-6);
  }

  .hero-actions .text-button {
    color: var(--hw-color-on-media);
  }

  .hero :focus-visible {
    outline-color: var(--hw-color-on-media);
  }

  .hero-server {
    min-width: 0;
  }

  .server-card {
    padding: clamp(16px, 2.2vw, 24px);
    border: 1px solid var(--md-sys-color-outline-variant);
    border-radius: var(--md-sys-shape-corner-large);
    background: var(--md-sys-color-surface-container-lowest);
    color: var(--md-sys-color-on-surface);
  }

  .server-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--hw-space-3);
  }

  .server-status {
    display: inline-flex;
    align-items: center;
    gap: var(--hw-space-2);
    color: var(--md-sys-color-on-surface-variant);
    font-size: var(--md-sys-typescale-label-medium-size);
    font-weight: 600;
  }

  .server-status[data-state='online'] {
    color: var(--md-sys-color-primary);
  }

  .server-status[data-state='error'] {
    color: var(--md-sys-color-error);
  }

  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: currentColor;
  }

  .server-status[data-state='checking'] .status-dot {
    animation: status-pulse 1.2s var(--md-sys-motion-easing-standard) infinite;
  }

  @keyframes status-pulse {
    0%,
    100% {
      opacity: 0.35;
    }

    50% {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .server-status[data-state='checking'] .status-dot {
      animation: none;
    }
  }

  .server-code {
    font-size: var(--md-sys-typescale-label-small-size);
    font-weight: 500;
    letter-spacing: 0.14em;
    color: var(--md-sys-color-on-surface-variant);
  }

  .server-address {
    margin-top: var(--hw-space-5);
  }

  .server-label {
    display: block;
    font-size: var(--md-sys-typescale-label-small-size);
    letter-spacing: 0.1em;
    color: var(--md-sys-color-on-surface-variant);
  }

  .address-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    /* 320px 下地址只差 1px 就会把端口拆行，间距取最小 token 把余量让给文字 */
    gap: var(--hw-space-1);
    margin-top: 2px;
  }

  .address-row code {
    font-size: clamp(0.875rem, 1.5vw, 1.0625rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    word-break: break-all;
  }

  .server-copy {
    flex: 0 0 auto;
    width: 44px;
    height: 44px;
    color: var(--md-sys-color-primary);
  }

  .server-meta {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
