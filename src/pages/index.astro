---
import PortalLayout from '../layouts/PortalLayout.astro';
import { site } from '../data/site';
import '../styles/survival.css';
---

<PortalLayout title={`${site.siteName} - 生存服官网`} current="home">
  <section class="hero section-reveal">
    <div class="hero-media" aria-hidden="true">
      <img src="/images/hero-spawn.webp" alt="" width="1672" height="941" />
      <div class="hero-shade"></div>
    </div>

    <div class="hero-layout">
      <div class="hero-content">
        <p class="eyebrow">Minecraft Java 生存服务器</p>
        <h1>{site.heroTitle}</h1>
        <p class="hero-lead">{site.heroLead}</p>

        <div class="hero-actions">
          <button class="primary-action" type="button" data-copy-server>
            <span>复制服务器地址</span>
            <strong data-server-address>{site.serverAddress}</strong>
          </button>
          <a class="ghost-action" href="#join">查看加入步骤</a>
        </div>
      </div>

      <aside class="server-ticket" aria-label="服务器状态">
        <div class="ticket-topline">
          <span class="live-dot"></span>
          <strong>{site.serverState}</strong>
        </div>
        <div class="ticket-count">
          <span>当前在线</span>
          <strong>
            <b>{site.onlineCount}</b>
            <small>/</small>
            <b>{site.maxCount}</b>
          </strong>
        </div>
        <dl class="ticket-meta">
          <div>
            <dt>服务器版本</dt>
            <dd>{site.serverVersion}</dd>
          </div>
          <div>
            <dt>服务器地址</dt>
            <dd>{site.serverAddress}</dd>
          </div>
        </dl>
        <div class="ticket-tags">
          {site.ticketTags.map((tag) => <span>{tag}</span>)}
        </div>
      </aside>

      <div class="hero-note" aria-label="近期提醒">
        <span>最近提醒</span>
        <strong>{site.notice}</strong>
      </div>
    </div>
  </section>

  <section class="section-block overview texture-section section-reveal" aria-label="服务器概览">
    <div class="section-heading">
      <p class="eyebrow">服务器概览</p>
      <h2>进服前先看这几件事</h2>
    </div>

    <div class="overview-grid">
      {
        site.overview.map((item) => (
          <article class="info-card">
            <span>{item.label}</span>
            <strong>{item.value}</strong>
            <p>{item.text}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section-block split-section section-reveal" id="features">
    <div class="section-heading sticky-heading">
      <p class="eyebrow">玩法展示</p>
      <h2>生存、建筑和活动都留在一个节奏里</h2>
      <p>在这里展示服务器玩法、建筑区域、活动内容和玩家社区。</p>
    </div>

    <div class="feature-list">
      {
        site.features.map((item) => (
          <article class="feature-card">
            <span class="feature-icon">{item.icon}</span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section-band section-reveal">
    <div class="band-copy">
      <p class="eyebrow">服务器节奏</p>
      <h2>服务器节奏</h2>
      <p>不追求一天毕业，也不强推复杂任务。玩家可以建家、开店、跑活动，也可以只是安静挖矿</p>
    </div>
    <div class="band-stats">
      {
        site.stats.map((item) => (
          <div class="band-stat">
            <strong>{item.value}</strong>
            <span>{item.label}</span>
          </div>
        ))
      }
    </div>
  </section>

  <section class="section-block scenery-section section-reveal" id="scenery">
    <div class="section-heading scenery-heading">
      <p class="eyebrow">服务器风景</p>
      <h2>让玩家先看到这个世界的样子</h2>
      <p>这里可以展示主城、玩家聚落、活动场和服务器地标。</p>
    </div>

    <div class="scenery-grid">
      {
        site.scenery.map((item, index) => (
          <article class={`scenery-card scenery-card-${index + 1}`}>
            <div class="scenery-image">
              <img src={item.image} alt={item.title} loading={index === 0 ? 'eager' : 'lazy'} />
            </div>
            <div class="scenery-body">
              <span>{`0${index + 1}`}</span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section-block news-section texture-section section-reveal" id="news">
    <div class="section-heading">
      <p class="eyebrow">最新公告</p>
      <h2>最近需要知道的事</h2>
    </div>

    <div class="news-grid">
      {
        site.news.map((item) => (
          <article class="news-card">
            <time>{item.date}</time>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section-block join-section section-reveal" id="join">
    <div class="section-heading">
      <p class="eyebrow">加入服务器</p>
      <h2>准备好版本后，就可以进来看看</h2>
    </div>

    <div class="join-panel">
      <div class="join-address">
        <span>服务器地址</span>
        <strong data-server-address>{site.serverAddress}</strong>
        <button type="button" data-copy-server>复制</button>
      </div>

      <ol class="join-steps">
        {
          site.joinSteps.map((step) => (
            <li>
              <strong>{step.title}</strong>
              <p>{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section-block community-section section-reveal" id="community">
    <div class="community-panel">
      <div class="community-copy">
        <p class="eyebrow">社群</p>
        <h2>{site.community.title}</h2>
        <p>{site.community.note}</p>
        <div class="community-links">
          {site.community.links.map((link) => <a href={link.href}>{link.label}</a>)}
        </div>
      </div>

      <div class="qr-card" aria-label="社群二维码">
        <div class="qr-frame">
          {
            site.community.qrImage ? (
              <img src={site.community.qrImage} alt={site.community.qrLabel} />
            ) : (
              <span class="qr-placeholder">{site.community.qrLabel}</span>
            )
          }
        </div>
        <strong>{site.community.qrLabel}</strong>
        <p>{site.community.qrNote}</p>
      </div>
    </div>
  </section>

  <section class="section-block faq-section section-reveal" id="faq">
    <div class="section-heading">
      <p class="eyebrow">常见问题</p>
      <h2>进服常见问题</h2>
    </div>

    <div class="faq-list">
      {
        site.faq.map((item) => (
          <article class="faq-item">
            <h3>{item.question}</h3>
            <p>{item.answer}</p>
          </article>
        ))
      }
    </div>
  </section>
</PortalLayout>

<div class="toast" data-toast role="status" aria-live="polite"></div>

<script>
  import { site } from '../data/site';

  const toast = document.querySelector<HTMLElement>('[data-toast]');
  let timer = 0;

  const show = (message: string) => {
    if (!toast) return;
    toast.textContent = message;
    toast.classList.add('is-visible');
    window.clearTimeout(timer);
    timer = window.setTimeout(() => toast.classList.remove('is-visible'), 2000);
  };

  document.querySelectorAll<HTMLElement>('[data-copy-server]').forEach((button) => {
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(site.serverAddress);
        show('服务器地址已复制');
      } catch {
        show(`请手动复制：${site.serverAddress}`);
      }
    });
  });
</script>
