---
import { getCollection } from 'astro:content';
import PortalLayout from '../../layouts/PortalLayout.astro';

const news = (await getCollection('news')).sort((a, b) =>
  a.data.date < b.data.date ? 1 : -1,
);
---

<PortalLayout
  title="公告 · Hydwind"
  description="Hydwind 版本更新、活动安排、规则调整与资源刷新公告。"
  current="wiki"
  solidHeader
>
  <section class="page-head">
    <a class="crumb" href="/">← 门户</a>
    <span class="eyebrow">Dispatch</span>
    <h1>最新公告</h1>
    <p class="lead">版本更新、活动安排、规则调整和资源刷新都会在这里公布。一条公告一个 Markdown 文件。</p>
    <p class="count">共 {news.length} 条 · 数据来自 src/content/news</p>
  </section>

  <section class="section" style="padding-top: 0">
    <div class="dispatch">
      {
        news.map((item) => (
          <a class="dispatch-row" href={`/news/${item.id}/`}>
            <time>{item.data.date}</time>
            <strong>{item.data.title}</strong>
            <span>{item.data.tag}</span>
          </a>
        ))
      }
    </div>
  </section>
</PortalLayout>
