---
import { getCollection } from 'astro:content';
import PortalLayout from '../../layouts/PortalLayout.astro';

const players = (await getCollection('players')).sort(
  (a, b) => a.data.order - b.data.order || a.data.ign.localeCompare(b.data.ign),
);

const orgs = await getCollection('orgs');
const orgName = new Map(orgs.map((org) => [org.id, org.data.name]));

const statuses = ['全部', '活跃', '休假', '暂离', '已退服'];
---

<PortalLayout
  title="玩家自传 · Hydwind"
  description="Hydwind 玩家自己写的档案：加入时间、所属组织、擅长方向。"
  current="players"
  solidHeader
>
  <section class="page-head">
    <a class="crumb" href="/">← 门户</a>
    <span class="eyebrow">Players</span>
    <h1>玩家自传</h1>
    <p class="lead">
      每人一个 Markdown 文件，正文由玩家自己写。档案里的 <code>org</code> 字段会与公开组织自动关联，
      组织页因此能直接列出成员，不需要两边各改一次。
    </p>
    <p class="count">共 {players.length} 份档案 · 数据来自 src/content/players</p>
  </section>

  <section class="section" style="padding-top: 0">
    <div class="filter-bar">
      {
        statuses.map((status) => (
          <button class="chip is-active" type="button" data-filter={status}>
            {status}
          </button>
        ))
      }
      <input class="search-input" type="search" placeholder="搜索 IGN / 身份 / 标签" data-search aria-label="搜索玩家" />
    </div>

    <div class="player-grid">
      {
        players.map((player) => (
          <a
            class="player-card"
            href={`/players/${player.id}/`}
            data-status={player.data.status}
            data-search={`${player.data.ign} ${player.data.role ?? ''} ${player.data.tags.join(' ')}`.toLowerCase()}
          >
            <span class="ign">{player.data.ign}</span>
            <span class="role">{player.data.role ?? '玩家'}</span>
            <p>{player.data.summary}</p>
            <div class="foot">
              <span>{player.data.org ? orgName.get(player.data.org) ?? player.data.org : '独立玩家'}</span>
              <span>·</span>
              <span>{player.data.status}</span>
            </div>
          </a>
        ))
      }
    </div>
  </section>
</PortalLayout>

<script>
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter]'));
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-status]'));
  const search = document.querySelector<HTMLInputElement>('[data-search]');

  let active = '全部';

  const apply = () => {
    const keyword = (search?.value ?? '').trim().toLowerCase();
    cards.forEach((card) => {
      const statusOk = active === '全部' || card.dataset.status === active;
      const textOk = !keyword || (card.dataset.search ?? '').includes(keyword);
      card.style.display = statusOk && textOk ? '' : 'none';
    });
  };

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      active = chip.dataset.filter ?? '全部';
      chips.forEach((item) => item.classList.toggle('is-active', item === chip));
      apply();
    });
  });

  search?.addEventListener('input', apply);
</script>
