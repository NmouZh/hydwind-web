---
import { getCollection, render } from 'astro:content';
import PortalLayout from '../../layouts/PortalLayout.astro';

export async function getStaticPaths() {
  const [players, orgs] = await Promise.all([getCollection('players'), getCollection('orgs')]);
  const orgMap = new Map(orgs.map((org) => [org.id, org]));

  return players.map((player) => ({
    params: { slug: player.id },
    props: {
      player,
      org: player.data.org ? orgMap.get(player.data.org) ?? null : null,
    },
  }));
}

const { player, org } = Astro.props;
const { Content } = await render(player);
const { data } = player;
---

<PortalLayout
  title={`${data.ign} · 玩家自传 · Hydwind`}
  description={data.summary}
  current="players"
  solidHeader
>
  <section class="page-head">
    <a class="crumb" href="/players/">← 玩家自传</a>
    <span class="eyebrow">玩家档案 · {data.status}</span>
    <h1>{data.ign}</h1>
    <p class="lead">{data.summary}</p>
  </section>

  <div class="detail">
    <article class="detail-body">
      <Content />
    </article>

    <aside class="detail-aside">
      <dl class="meta-table">
        <div><dt>IGN</dt><dd>{data.ign}</dd></div>
        {data.role && <div><dt>身份</dt><dd>{data.role}</dd></div>}
        {data.joined && <div><dt>加入</dt><dd>{data.joined}</dd></div>}
        <div><dt>状态</dt><dd>{data.status}</dd></div>
        <div>
          <dt>所属组织</dt>
          <dd>
            {org ? <a href={`/orgs/${org.id}/`} style="text-decoration: underline">{org.data.name}</a> : '独立玩家'}
          </dd>
        </div>
      </dl>

      {
        data.tags.length > 0 && (
          <div class="aside-block">
            <h2>标签</h2>
            <div style="display:flex;flex-wrap:wrap;gap:8px">
              {data.tags.map((tag) => <span class="tag">{tag}</span>)}
            </div>
          </div>
        )
      }

      <div class="aside-block">
        <h2>继续浏览</h2>
        <div class="aside-list">
          <a href="/players/">全部玩家<span>→</span></a>
          {org && <a href={`/orgs/${org.id}/`}>查看 {org.data.name}<span>→</span></a>}
        </div>
      </div>
    </aside>
  </div>
</PortalLayout>
