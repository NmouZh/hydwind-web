---
// 内容页在构建期渲染成静态 HTML，只有 /api/* 走服务端
export const prerender = true;
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import ServerInfo from '../../components/ServerInfo.astro';
import GuideSteps from '../../components/GuideSteps.astro';
import { formatDate } from '../../lib/format';
import { JOIN_GUIDE_ID, getAllGuides, getSite } from '../../lib/content';

export async function getStaticPaths() {
  const guides = await getAllGuides();
  return guides.map((guide) => ({
    params: { slug: guide.id },
    props: { guide },
  }));
}

interface Props {
  guide: CollectionEntry<'guides'>;
}

const { guide } = Astro.props;
const { Content } = await render(guide);

const site = await getSite();
const isJoinGuide = guide.id === JOIN_GUIDE_ID;
---

<BaseLayout
  title={`${guide.data.title} · 指南 · 氢风 Hydwind`}
  description={guide.data.summary}
  current="guides"
>
  <div class="hw-shell page-shell">
    <nav class="breadcrumb" aria-label="面包屑">
      <a href="/guides/">指南</a>
      <span aria-hidden="true">/</span>
      <span>{guide.data.title}</span>
    </nav>

    <header class="page-header enter">
      <p class="hw-eyebrow">指南</p>
      <h1>{guide.data.title}</h1>
      <div class="page-header-aside">
        <p class="page-lede">{guide.data.summary}</p>
        <div class="page-actions">
          <a class="outlined-button" href="/guides/">
            <Icon name="arrow_back" size={18} />
            返回指南
          </a>
        </div>
      </div>
    </header>

    {
      isJoinGuide && (
        <div class="server-info-wrap">
          <ServerInfo site={site} />
        </div>
      )
    }

    <div class="detail-layout">
      <div class="detail-main">
        <section class="steps-section" aria-labelledby="steps-title">
          <h2 id="steps-title">按顺序完成</h2>
          <GuideSteps steps={guide.data.steps} />
        </section>

        <article class="prose">
          <Content />
        </article>
      </div>

      <aside class="detail-aside">
        <p class="hw-label">本页信息</p>
        <dl class="meta-list">
          <div>
            <dt>章节</dt>
            <dd>{guide.data.steps.length} 个步骤</dd>
          </div>
          <div>
            <dt>更新于</dt>
            <dd>{formatDate(guide.data.updated)}</dd>
          </div>
        </dl>
        <a class="text-button" href="/">
          回到首页
          <Icon name="arrow_forward" size={18} />
        </a>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .server-info-wrap {
    margin-top: var(--hw-space-7);
  }

  .steps-section {
    padding-bottom: var(--hw-space-7);
    border-bottom: 1px solid var(--md-sys-color-outline-variant);
  }

  .steps-section h2 {
    font-size: var(--md-sys-typescale-headline-medium-size);
  }

  .prose {
    margin-top: var(--hw-space-7);
  }

  .detail-aside .text-button {
    justify-self: start;
  }
</style>
