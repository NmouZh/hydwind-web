---
// 内容页在构建期渲染成静态 HTML，只有 /api/* 走服务端
export const prerender = true;
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import ServerInfo from '../../components/ServerInfo.astro';
import GuideSteps from '../../components/GuideSteps.astro';
import { formatDate } from '../../lib/format';
import { JOIN_GUIDE_ID, getAllGuides, getSite } from '../../lib/content';
import '../../styles/guides.css';

export async function getStaticPaths() {
  const guides = await getAllGuides();
  return guides.map((guide) => ({
    params: { slug: guide.id },
    props: { guide },
  }));
}

interface Props {
  guide: CollectionEntry<'guides'>;
}

const { guide } = Astro.props;
const { Content } = await render(guide);

const site = await getSite();
const isJoinGuide = guide.id === JOIN_GUIDE_ID;
---

<BaseLayout
  title={`${guide.data.title} · 指南 · 氢风 Hydwind`}
  description={guide.data.summary}
  current="guides"
>
  <div class="hw-shell page-shell guide-detail">
    <nav class="breadcrumb" aria-label="面包屑">
      <a href="/guides/">指南</a>
      <span aria-hidden="true">/</span>
      <span>{guide.data.title}</span>
    </nav>

    <header class="guide-hero guide-hero--detail enter">
      <p class="hw-eyebrow">Guide · 指南</p>
      <h1 class="guide-title">{guide.data.title}</h1>
      <p class="guide-lead">{guide.data.summary}</p>
      <div class="guide-meta">
        <span class="assist-chip">{guide.data.steps.length} 个步骤</span>
        <span class="assist-chip">更新于 {formatDate(guide.data.updated)}</span>
      </div>
    </header>

    <div class="guide-layout">
      <div class="guide-main">
        <section class="guide-section" aria-labelledby="steps-title">
          <div class="guide-section-head">
            <div>
              <p class="hw-eyebrow">Route</p>
              <h2 id="steps-title">按顺序完成</h2>
            </div>
            <span class="guide-section-count">{guide.data.steps.length} 步</span>
          </div>
          <GuideSteps steps={guide.data.steps} variant="route" />
        </section>

        <section class="guide-section guide-notes" aria-labelledby="notes-title" data-reveal>
          <div class="guide-section-head">
            <div>
              <p class="hw-eyebrow">Notes</p>
              <h2 id="notes-title">补充说明</h2>
            </div>
          </div>
          <article class="prose">
            <Content />
          </article>
        </section>
      </div>

      <aside class="guide-aside" aria-label="本页信息">
        {isJoinGuide && <ServerInfo site={site} />}

        <nav class="step-nav" aria-label="本页步骤">
          <p class="hw-label">本页步骤</p>
          {
            guide.data.steps.map((step, index) => (
              <a href={`#step-${index + 1}`}>
                <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                {step.title}
              </a>
            ))
          }
        </nav>

        <a class="text-button guide-back" href="/guides/">
          <Icon name="arrow_back" size={18} />
          返回指南
        </a>
      </aside>
    </div>
  </div>
</BaseLayout>
