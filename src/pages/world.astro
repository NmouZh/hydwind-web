---
import PortalLayout from '../layouts/PortalLayout.astro';
import { site } from '../data/site';
import '../styles/survival.css';
---

<PortalLayout title={`世界地图 - ${site.siteName}`} description="服务器地标、交通路线、资源世界和活动区域" current="world" solidHeader>
  <main class="subpage-main">
    <section class="page-hero section-reveal">
      <a class="crumb-link" href="/">返回首页</a>
      <p class="eyebrow">世界地图</p>
      <h1>世界地图</h1>
      <p>这里展示主城、市场、交通点、资源世界门和玩家建家区域。</p>
    </section>

    <section class="section-block world-layout section-reveal">
      <div class="map-stage">
        <img src="/images/scenery-lake.webp" alt="服务器地图展示图" width="1672" height="941" />
        <div class="map-pin pin-spawn"><span>主城</span></div>
        <div class="map-pin pin-market"><span>市场</span></div>
        <div class="map-pin pin-harbor"><span>湖港</span></div>
      </div>

      <aside class="content-panel map-note">
        <span class="panel-kicker">坐标速览</span>
        <h2>常用地点</h2>
        <dl class="coordinate-list">
          <div><dt>主城广场</dt><dd>X 0 / Z 0</dd></div>
          <div><dt>玩家市场</dt><dd>X 128 / Z -64</dd></div>
          <div><dt>资源世界门</dt><dd>X -96 / Z 48</dd></div>
          <div><dt>活动场</dt><dd>X 220 / Z 180</dd></div>
        </dl>
      </aside>
    </section>

    <section class="section-block section-reveal">
      <div class="route-grid">
      <article class="route-card">
        <span>01</span>
        <h2>新人路线</h2>
        <p>主城、公告板、公共农场、市场和传送大厅。</p>
      </article>
      <article class="route-card">
        <span>02</span>
        <h2>建家区域</h2>
        <p>主城外圈保留公共空间，玩家可以从北侧森林、南侧平原或湖边区域开始寻找地块。</p>
      </article>
      <article class="route-card">
        <span>03</span>
        <h2>资源采集</h2>
        <p>资源世界刷新周期、采集范围和结构探索规则。</p>
      </article>
    </div>
    </section>
  </main>
</PortalLayout>
