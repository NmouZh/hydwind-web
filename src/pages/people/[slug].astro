---
// 人物详情页走 SSR：静态人物资料来自内容集合，传记与评论来自运行时的
// biographies.json；同一个 URL 还要按登录身份决定「能不能编辑 / 删除」。
export const prerender = false;

import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ErrorPage from '../../components/ErrorPage.astro';
import Icon from '../../components/Icon.astro';
import PlayerAvatar from '../../components/PlayerAvatar.astro';
import '../../styles/error.css';
import { findAccount, listAccounts } from '../../lib/accounts';
import {
  canEditBiography,
  defaultMainTitle,
  findBiographyByGameId,
  listComments,
  MAX_BIO_BODY,
  MAX_BIO_TITLE,
  MAX_COMMENT_BODY,
  resolvePersonBySlug,
} from '../../lib/biographies';
import {
  formatBiographyDate,
  renderBiographyHtml,
  type BiographyRef,
} from '../../lib/biography-text';
import { presentComment } from '../../lib/comments';
import {
  JOIN_GUIDE_ID,
  getPublishedPeople,
} from '../../lib/content';
import { formatDate } from '../../lib/format';
import {
  biographyEmptyMessage,
  biographyTitle,
  canDeleteCommentForAuthor,
  commentAuthorLabel,
  formatCommentTime,
  groupCommentsByDay,
  hasReadableBody,
  type ViewerState,
} from '../../lib/person-page';
import { readSession } from '../../lib/session';

const slug = Astro.params.slug ?? '';

// 静态人物既有 curated 资料（角色 / 标签 / 头像 / Markdown），也是 slug 解析的
// 第一优先级；账号只有传记与评论。
const people = await getPublishedPeople();
const staticPeople = people.map(({ id, data }) => ({ id, gameId: data.gameId }));
const resolved = await resolvePersonBySlug(slug, { staticPeople, findAccount });

if (!resolved) Astro.response.status = 404;

const staticPerson = resolved?.personId
  ? people.find((person) => person.id === resolved.personId)
  : undefined;
const renderedContent = staticPerson ? await render(staticPerson) : null;
const Content = renderedContent?.Content;

const session = resolved ? readSession(Astro.cookies) : null;
const viewer = session ? await findAccount(session.username) : undefined;
const gameId = resolved?.gameId ?? '';
const biography = resolved ? await findBiographyByGameId(gameId) : null;

// 角色以账号文件为准，不信任 cookie 里的旧 role。
const canEdit = canEditBiography(
  viewer ? { username: viewer.username, role: viewer.role } : null,
  gameId
);
const viewerState: ViewerState = canEdit ? 'owner' : viewer ? 'viewer' : 'guest';

const mainTitle = resolved ? biographyTitle(biography, gameId) : '';
const body = biography?.body ?? '';
// 静态人物自带的 Markdown 正文也算「有正文」；否则列表说有内容、
// 详情页却显示「正文尚未填写」。两条路径共用 hasReadableBody。
const hasStaticBody = Boolean(staticPerson?.body?.trim());
const hasBody = hasReadableBody(hasStaticBody, body);
const emptyMessage = resolved ? biographyEmptyMessage(gameId, viewerState) : '';

/**
 * `@游戏ID` → 人物页链接的映射。静态人物保留 entry id 的地址，
 * 账号使用小写 username（与 slug 解析一致）；都没有就当普通文字。
 */
const refMap = new Map<string, string>();
for (const person of people) refMap.set(person.data.gameId, person.id);
for (const account of resolved ? await listAccounts() : []) {
  if (!refMap.has(account.username)) refMap.set(account.username, account.username.toLowerCase());
}
const refs: BiographyRef[] = [...refMap].map(([gameId, personId]) => ({ gameId, personId }));
const bodyHtml = body.trim() ? renderBiographyHtml(body, refs) : '';

const comments = resolved ? await listComments(gameId) : [];
const presented = await Promise.all(
  comments.map(async (comment) => ({
    ...(await presentComment(comment)),
    canDelete: canDeleteCommentForAuthor(
      comment.authorUsername,
      viewer ? { username: viewer.username, role: viewer.role } : null
    ),
  }))
);
const commentGroups = groupCommentsByDay(presented);

const description = staticPerson
  ? `${staticPerson.data.gameId} 是氢风的${staticPerson.data.role}。查看人物简介、传记与评论。`
  : `${gameId} 的氢风玩家传记，包含自我介绍与玩家评论。`;
const pageTitle = resolved ? `${mainTitle} · 人物 · 氢风 Hydwind` : '页面不存在 · 氢风 Hydwind';
---

{
  resolved ? (
    <BaseLayout title={pageTitle} description={description} current="people">
      <div
        class="hw-shell page-shell"
        data-person-page
        data-slug={resolved.slug}
        data-game-id={gameId}
        data-viewer={viewer?.username ?? ''}
        data-viewer-admin={viewer?.role === 'admin' ? 'true' : 'false'}
        data-has-static-body={hasStaticBody ? 'true' : 'false'}
        data-refs={JSON.stringify(refs)}
      >
        <nav class="breadcrumb" aria-label="面包屑">
          <a href="/people/">人物</a>
          <span aria-hidden="true">/</span>
          <span>{gameId}</span>
        </nav>

        <header class="page-head person-head enter">
          <div class="page-head-copy person-head-copy">
            {staticPerson?.data.avatar ? (
              <PlayerAvatar gameId={gameId} src={staticPerson.data.avatar} size="detail" />
            ) : (
              <span class="person-initial" aria-hidden="true">
                {gameId.slice(0, 1).toUpperCase()}
              </span>
            )}
            <div>
              <h1 data-bio-title>{mainTitle}</h1>
              <p class="page-head-sub person-game-id">
                游戏 ID：<span>{gameId}</span>
              </p>
              {staticPerson && <p class="page-head-sub person-role">{staticPerson.data.role}</p>}
              {staticPerson && staticPerson.data.tags.length > 0 && (
                <div class="chip-row person-head-tags">
                  {staticPerson.data.tags.map((tag) => (
                    <span class="tag-chip">{tag}</span>
                  ))}
                </div>
              )}
            </div>
          </div>
          <div class="page-head-actions">
            <a class="outlined-button is-compact" href="/people/">
              <Icon name="arrow_back" size={16} />
              返回人物
            </a>
          </div>
        </header>

        <div class="detail-layout">
          <article class="prose person-static-content">
            {Content && <Content />}
          </article>

          <aside class="detail-aside">
            <p class="hw-label">档案</p>
            <dl class="meta-list">
              {staticPerson && (
                <div>
                  <dt>身份</dt>
                  <dd>{staticPerson.data.role}</dd>
                </div>
              )}
              {staticPerson?.data.joined && (
                <div>
                  <dt>加入时间</dt>
                  <dd>{formatDate(staticPerson.data.joined)}</dd>
                </div>
              )}
              {staticPerson && (
                <div>
                  <dt>资料更新</dt>
                  <dd>{formatDate(staticPerson.data.updated)}</dd>
                </div>
              )}
              <div>
                <dt>游戏 ID</dt>
                <dd>{gameId}</dd>
              </div>
            </dl>
            <div class="aside-actions">
              <a class="text-button" href={`/guides/${JOIN_GUIDE_ID}/`}>
                第一次进服
                <Icon name="arrow_forward" size={18} />
              </a>
            </div>
          </aside>
        </div>

        <section
          class="section person-biography"
        >
          <div class="section-heading">
            <div>
              <p class="hw-eyebrow">传记</p>
              <h2>玩家写的传记</h2>
            </div>
            <div class="bio-head-actions">
              {!viewer && (
                <a class="outlined-button is-compact" href="/account/" data-bio-entry="signin">
                  <Icon name="login" size={16} />
                  登录后编辑
                </a>
              )}
            </div>
          </div>

          <div class="bio-reading">
            <div class="bio-body prose" data-bio-body hidden={!bodyHtml} set:html={bodyHtml} />
            <p class="bio-empty" data-bio-empty hidden={hasBody}>{emptyMessage}</p>
            <p class="bio-meta" data-bio-updated hidden={!biography?.updatedAt}>
              {biography?.updatedAt ? `最后更新：${formatBiographyDate(biography.updatedAt)}` : ''}
            </p>
          </div>

          {canEdit && (
            <form class="form-stack bio-editor panel" data-bio-editor>
              <label class="field">
                <span>主标题</span>
                <input
                  name="mainTitle"
                  type="text"
                  maxlength={MAX_BIO_TITLE}
                  value={mainTitle}
                  autocomplete="off"
                  data-bio-title-input
                />
              </label>
              <span class="field-hint">
                2–{MAX_BIO_TITLE} 字；留空会恢复为「{defaultMainTitle(gameId)}」。
              </span>
              <label class="field">
                <span>正文（Markdown）</span>
                <textarea name="body" rows="12" maxlength={MAX_BIO_BODY} data-bio-input>{body}</textarea>
              </label>
              <span class="field-hint">
                正文可以留空。支持标题、列表、引用、粗体、链接和 @游戏ID。
              </span>
              <div class="bio-actions">
                <button class="filled-button is-compact" type="submit" data-bio-submit>
                  保存传记
                </button>
              </div>
              <p class="form-status" role="status" aria-live="polite" data-bio-status></p>
            </form>
          )}

          {!canEdit && viewer && (
            <p class="bio-note">这篇传记只有作者本人和站务能改，想补充可以找站务。</p>
          )}
        </section>

        <section class="section person-comments" data-comments>
          <div class="section-heading">
            <div>
              <p class="hw-eyebrow">评论</p>
              <h2>
                聊两句
                <span class="comment-count" data-comment-count>{presented.length}</span>
              </h2>
            </div>
          </div>

          {viewer ? (
            <form class="form-stack comment-form panel" data-comment-form>
              <label class="field">
                <span>评论（最多 {MAX_COMMENT_BODY} 字）</span>
                <textarea
                  name="body"
                  rows="3"
                  maxlength={MAX_COMMENT_BODY}
                  required
                  data-comment-input
                  placeholder={`对 ${gameId} 说点什么…`}
                ></textarea>
              </label>
              <button class="filled-button is-compact" type="submit" data-comment-submit>
                发表评论
              </button>
              <p class="form-status" role="status" aria-live="polite" data-comment-status></p>
            </form>
          ) : (
            <p class="comment-signin">
              登录后可以发表评论。
              <a class="text-button" href="/account/">
                去登录
                <Icon name="arrow_forward" size={18} />
              </a>
            </p>
          )}

          <div class="comment-list" data-comment-list>
            {commentGroups.map((group) => (
              <div class="comment-day">
                <p class="hw-label comment-day-label">{group.date}</p>
                {group.comments.map((comment) => (
                  <article class="comment" data-comment-id={comment.id}>
                    <header class="comment-head">
                      <span class="comment-author">
                        {commentAuthorLabel(comment.authorDisplay, comment.authorGameId)}
                      </span>
                      <time class="comment-time" datetime={comment.createdAt}>
                        {formatCommentTime(comment.createdAt)}
                      </time>
                    </header>
                    <p class="comment-body">{comment.body}</p>
                    {comment.canDelete && (
                      <button
                        class="text-button comment-delete"
                        type="button"
                        data-comment-delete={comment.id}
                      >
                        删除
                      </button>
                    )}
                  </article>
                ))}
              </div>
            ))}
          </div>
          <p class="comment-empty" data-comment-empty hidden={presented.length > 0}>
            还没有评论，来坐第一排。
          </p>
        </section>
      </div>
    </BaseLayout>
  ) : (
    <BaseLayout
      title="页面不存在 · 氢风 Hydwind"
      description="这个地址没有对应的页面。回首页，或者看看进服指南。"
      current="home"
      noindex
    >
      <ErrorPage
        code="404"
        eyebrow="Not Found"
        title="这条路没通向服务器。"
        description="地址可能写错了，或者这个页面已经搬走。回首页看看，或者先去读一遍进服指南。"
      />
    </BaseLayout>
  )
}

<script>
  import { initPersonPage } from '../../scripts/person-page';

  void initPersonPage();
</script>

<style>
  .person-head-copy {
    display: flex;
    align-items: center;
    gap: var(--hw-space-4);
  }

  .person-initial {
    display: grid;
    place-items: center;
    width: clamp(84px, 13vw, 120px);
    height: clamp(84px, 13vw, 120px);
    border-radius: var(--md-sys-shape-corner-large);
    background: var(--md-sys-color-primary-container);
    color: var(--md-sys-color-on-primary-container);
    font-size: clamp(2rem, 6vw, 3rem);
    font-weight: 700;
    line-height: 1;
  }

  .person-game-id {
    font-variant-numeric: tabular-nums;
  }

  .person-role {
    margin-top: var(--hw-space-1);
  }

  .person-head-tags {
    margin-top: var(--hw-space-2);
  }

  .person-static-content {
    margin-top: 0;
  }

  .aside-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--hw-space-2);
    margin-top: var(--hw-space-4);
  }

  /* —— 传记：读 —— */

  .person-biography {
    margin-top: var(--hw-space-7);
  }

  .bio-head-actions {
    display: flex;
    align-items: center;
    gap: var(--hw-space-2);
  }

  .bio-reading {
    min-width: 0;
    margin-top: var(--hw-space-4);
  }

  /* 正文排版来自 base.css 的共享 `.prose`；这里只补传记特有的引用样式。 */
  .bio-body {
    font-size: var(--md-sys-typescale-title-large-size);
  }

  .bio-body :global(.bio-mention) {
    color: var(--md-sys-color-primary);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--md-sys-color-primary) 35%, transparent);
    text-underline-offset: 3px;
  }

  .bio-empty,
  .bio-meta,
  .bio-note {
    max-width: 62ch;
    font-size: var(--md-sys-typescale-body-medium-size);
    color: var(--md-sys-color-on-surface-variant);
  }

  .bio-empty {
    margin-top: var(--hw-space-3);
  }

  .bio-meta {
    margin-top: var(--hw-space-4);
    font-size: var(--md-sys-typescale-label-medium-size);
    font-variant-numeric: tabular-nums;
  }

  .bio-note {
    margin-top: var(--hw-space-4);
    font-size: var(--md-sys-typescale-label-medium-size);
  }

  /* —— 传记：写 —— */

  .bio-editor {
    margin-top: var(--hw-space-5);
  }

  .bio-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--hw-space-3);
    align-items: center;
  }

  /* —— 评论 —— */

  .comment-form {
    margin-top: var(--hw-space-5);
  }

  .comment-count {
    display: inline-block;
    margin-left: var(--hw-space-2);
    color: var(--md-sys-color-on-surface-variant);
    font-size: var(--md-sys-typescale-label-large-size);
    font-variant-numeric: tabular-nums;
  }

  .comment-signin {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--hw-space-2);
    margin-top: var(--hw-space-4);
    font-size: var(--md-sys-typescale-body-medium-size);
    color: var(--md-sys-color-on-surface-variant);
  }

  .comment-list {
    display: grid;
    gap: var(--hw-space-5);
    margin-top: var(--hw-space-5);
  }

  .comment-day-label {
    margin: 0 0 var(--hw-space-2);
  }

  .comment {
    padding: var(--hw-space-4) 0;
    border-top: 1px solid var(--md-sys-color-outline-variant);
  }

  .comment-day:first-child .comment:first-of-type {
    border-top: 0;
    padding-top: 0;
  }

  .comment-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--hw-space-2) var(--hw-space-4);
  }

  .comment-author {
    font-size: var(--md-sys-typescale-label-large-size);
    font-weight: 600;
  }

  .comment-time {
    font-size: var(--md-sys-typescale-label-small-size);
    font-variant-numeric: tabular-nums;
    color: var(--md-sys-color-on-surface-variant);
  }

  .comment-body {
    max-width: 62ch;
    margin-top: var(--hw-space-2);
    line-height: 1.75;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .comment-delete {
    margin-top: var(--hw-space-2);
    color: var(--md-sys-color-error);
  }

  .comment-empty {
    margin-top: var(--hw-space-4);
    font-size: var(--md-sys-typescale-body-medium-size);
    color: var(--md-sys-color-on-surface-variant);
  }

  @media (max-width: 838.98px) {
    .person-head-copy {
      gap: var(--hw-space-3);
    }

    .person-head :global(.detail-avatar) {
      width: 72px;
      height: 72px;
    }

    .person-initial {
      width: 72px;
      height: 72px;
      font-size: 2rem;
    }
  }
</style>