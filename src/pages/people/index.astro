---
// 内容页在构建期渲染成静态 HTML，只有 /api/* 走服务端
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import PersonCard from '../../components/PersonCard.astro';
import { getPublishedPeople } from '../../lib/content';

const people = await getPublishedPeople();
---

<BaseLayout
  title="人物 · 氢风 Hydwind"
  description="氢风服务器的人物传记，记录已发布玩家的游戏 ID、身份与简介。"
  current="people"
>
  <div class="hw-shell page-shell">
    <header class="page-head enter">
      <div class="page-head-copy">
        <h1>服务器里真实存在的人</h1>
        <p class="page-head-sub">
          这里只收录真实玩家的公开信息。编辑权限由服主授权，内容以 Markdown 维护，可通过 Pages CMS 更新。
        </p>
      </div>
    </header>

    {
      people.length > 0 && (
        <div class="list-rows people-list">
          {people.map((person, index) => (
            <PersonCard person={person} headingLevel={2} delay={80 + index * 60} />
          ))}
        </div>
      )
    }
  </div>
</BaseLayout>

<style>
  .people-list {
    margin-top: var(--hw-space-5);
    border-top: 0;
  }
</style>
