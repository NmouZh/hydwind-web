---
// 账号页在构建期出静态壳，登录态由浏览器拉 /api/auth/me 补水，
// 和 /issues/ 保持同一套架构：内容页静态、状态走 /api/*。
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { getSite } from '../lib/content';

const site = await getSite();

const description =
  '氢风（Hydwind）账号中心：登录站内账号，查看身份与最近登录；账号由群内 @机器人 注册后私信发放。';
---

<BaseLayout title="账号 · 氢风 Hydwind" description={description} current="account">
  <section class="hw-shell page-shell account-shell">
    <header class="page-head enter">
      <div class="page-head-copy">
        <h1 data-head-title tabindex="-1">登录氢风</h1>
        <p class="page-head-sub" data-head-sub>
          账号只在群里发放：@机器人 发「注册 你的游戏ID」，账号和初始密码会私信给你。
        </p>
      </div>
    </header>

    <div class="account-layout">
      <div class="account-main enter" style="--enter-delay: 60ms">
        <div class="account-panel panel">
          <div class="account-view" data-view="guest">
            <div class="account-intro">
              <h2>用游戏 ID 登录</h2>
              <p>账号和初始密码由群内机器人私信；忘了或想改密码，同样私信机器人处理。</p>
            </div>

            <form class="form-stack account-form" data-form novalidate>
              <label class="field">
                <span>账号（游戏 ID）</span>
                <span class="field-control" data-field="username">
                  <Icon name="person" size={16} />
                  <input
                    name="username"
                    type="text"
                    autocomplete="username"
                    autocapitalize="off"
                    spellcheck="false"
                    maxlength="16"
                    required
                    placeholder="例如 Nz_173"
                    aria-describedby="account-username-hint"
                  />
                </span>
              </label>
              <p class="field-hint" id="account-username-hint">
                只填字母、数字和下划线，3 到 16 位。
              </p>

              <label class="field">
                <span>密码</span>
                <span class="field-control" data-field="password">
                  <Icon name="key" size={16} />
                  <input
                    name="password"
                    type="password"
                    autocomplete="current-password"
                    maxlength="200"
                    required
                    placeholder="私信里给你的密码"
                    aria-describedby="account-password-hint"
                    enterkeyhint="go"
                  />
                  <button
                    class="field-action"
                    type="button"
                    data-toggle-password
                    aria-label="显示密码"
                    aria-pressed="false"
                  >
                    <Icon name="eye" size={18} />
                    <Icon name="eye_off" size={18} hidden />
                  </button>
                </span>
              </label>
              <p class="field-hint" id="account-password-hint">
                密码是群内机器人私信给你的那串字符。
              </p>
              <p class="field-note" data-caps-lock role="status" aria-live="polite" hidden>
                大写锁定开着，密码会不一样。
              </p>

              <button class="filled-button account-submit" type="submit" data-submit data-magnetic>
                登录
              </button>
              <p class="form-status" data-status role="status" aria-live="polite"></p>
            </form>

            <div class="notice account-help">
              <div>
                <p class="hw-label">还没有账号 / 忘了密码</p>
                <p>
                  在官方 QQ 群 @机器人 发「注册 你的游戏ID」，机器人会把账号和初始密码私信给你。
                </p>
              </div>
              <div class="account-help-actions">
                <code>{site.qqGroup}</code>
                <button
                  class="text-button is-compact"
                  type="button"
                  data-copy={site.qqGroup}
                  aria-label={`复制 QQ 群号 ${site.qqGroup}`}
                >
                  <Icon name="copy" size={16} />
                  复制群号
                </button>
                <a class="text-link" href="/guides/join/">看进服指南</a>
              </div>
            </div>

            <p class="account-foot">账号和密码只在群内发放，不会公开发在群里。</p>
          </div>

          <div class="account-view" data-view="member" hidden>
            <div class="account-intro">
              <h2>已登录</h2>
              <p>下面是你这个账号在氢风的记录，改密码请私信群内机器人。</p>
            </div>

            <dl class="meta-list-compact account-meta">
              <div>
                <dt>身份</dt>
                <dd data-member-role></dd>
              </div>
              <div>
                <dt>注册时间</dt>
                <dd data-member-created></dd>
              </div>
              <div>
                <dt>最近登录</dt>
                <dd data-member-login></dd>
              </div>
            </dl>
            <div class="page-actions account-actions">
              <a class="filled-button" href="/issues/">
                <Icon name="message" size={18} />
                去议题区
              </a>
              <button class="outlined-button" type="button" data-logout>退出登录</button>
            </div>
            <p class="form-status" data-member-status role="status" aria-live="polite"></p>
          </div>
        </div>
      </div>

      <aside class="account-aside enter" style="--enter-delay: 160ms">
        <p class="hw-label">账号说明</p>
        <dl class="account-notes">
          <div>
            <dt>账号从群里来</dt>
            <dd>在群里 @机器人 发送「注册 你的游戏ID」，机器人会私信账号和初始密码。</dd>
          </div>
          <div>
            <dt>密码只私信发</dt>
            <dd>账号和密码不会公开在群里，改密码同样私信机器人处理。</dd>
          </div>
          <div>
            <dt>登录能待 30 天</dt>
            <dd>登录状态会保留 30 天，公共设备用完请点退出。</dd>
          </div>
        </dl>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .account-shell {
    padding-block: clamp(24px, 3.4vw, 40px) var(--hw-space-9);
  }

  .account-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(240px, 0.55fr);
    gap: clamp(28px, 6vw, 88px);
    align-items: start;
    margin-top: clamp(24px, 3vw, 36px);
  }

  .account-main {
    min-width: 0;
  }

  .account-panel {
    max-width: 30rem;
  }

  .account-intro h2 {
    font-size: var(--md-sys-typescale-title-large-size);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .account-intro p {
    margin-top: var(--hw-space-2);
    color: var(--md-sys-color-on-surface-variant);
    font-size: var(--md-sys-typescale-body-medium-size);
    line-height: 1.6;
  }

  .account-form {
    gap: var(--hw-space-3);
    margin-top: var(--hw-space-5);
  }

  /* 输入框改成「容器套图标 + 输入」，边框和焦点环落在容器上 */
  .field-control {
    display: flex;
    align-items: center;
    gap: var(--hw-space-2);
    padding-inline: var(--hw-space-3);
    border: 1px solid var(--md-sys-color-outline-variant);
    border-radius: var(--md-sys-shape-corner-medium);
    background: var(--md-sys-color-surface-container-lowest);
    transition:
      border-color var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-standard),
      box-shadow var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-standard);
  }

  .field-control:focus-within {
    border-color: var(--md-sys-color-primary);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--md-sys-color-primary) 18%, transparent); /* taste-skill-ignore 键盘聚焦环，不是静止装饰 */
  }

  .field-control > :global(svg) {
    flex: none;
    color: var(--md-sys-color-on-surface-variant);
    transition: color var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-standard);
  }

  /* 焦点进来时图标跟着变成主色，是「输入框活了」最省事的一笔 */
  .field-control:focus-within > :global(svg) {
    color: var(--md-sys-color-primary);
  }

  .field-control input {
    flex: 1 1 auto;
    min-width: 0;
    padding-block: 13px;
    border: 0;
    background: transparent;
    box-shadow: none; /* taste-skill-ignore 复位容器上的边框和阴影 */
    color: var(--md-sys-color-on-surface);
    font: inherit;
    font-weight: 400;
    font-size: var(--md-sys-typescale-body-medium-size);
  }

  .field-control input:focus {
    border-color: transparent;
    box-shadow: none; /* taste-skill-ignore 焦点环画在外层容器上 */
    outline: none;
  }

  /* Edge 自带的密码显隐按钮会和我们这个按钮撞在一起 */
  .field-control input::-ms-reveal,
  .field-control input::-ms-clear {
    display: none;
  }

  .field[data-invalid='true'] .field-control {
    border-color: var(--md-sys-color-error);
  }

  .field-action {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    min-width: 44px;
    margin-inline-end: calc(var(--hw-space-2) * -1);
    border: 0;
    border-radius: var(--md-sys-shape-corner-full);
    background: transparent;
    color: var(--md-sys-color-on-surface-variant);
    cursor: pointer;
    transition:
      background-color var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-standard),
      color var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-standard);
  }

  .field-action:hover {
    background: var(--md-sys-color-surface-container-high);
    color: var(--md-sys-color-on-surface);
  }

  .field-note {
    font-size: var(--md-sys-typescale-label-small-size);
    color: var(--md-sys-color-on-surface-variant);
  }

  /* 校验没过时轻轻抖一下：比只改个边框颜色更容易被看见，也很短 */
  @keyframes hw-field-shake {
    0%,
    100% {
      transform: translateX(0);
    }

    25% {
      transform: translateX(calc(var(--hw-space-1) * -1));
    }

    75% {
      transform: translateX(var(--hw-space-1));
    }
  }

  .field[data-shake='true'] {
    animation: hw-field-shake var(--md-sys-motion-duration-medium1)
      var(--md-sys-motion-easing-standard);
  }

  /* 提示文字是后填进去的，淡一下才不显得凭空弹出 */
  @keyframes hw-status-in {
    from {
      opacity: 0;
      transform: translateY(calc(var(--hw-space-1) * -1));
    }
  }

  .form-status:not(:empty) {
    animation: hw-status-in var(--md-sys-motion-duration-short4)
      var(--md-sys-motion-easing-emphasized-decelerate);
  }

  @media (prefers-reduced-motion: reduce) {
    .field[data-shake='true'],
    .form-status:not(:empty) {
      animation: none;
    }
  }

  .account-submit {
    justify-self: stretch;
    min-height: 46px;
    margin-top: var(--hw-space-2);
  }

  .account-submit[aria-busy='true'] {
    cursor: progress;
  }

  .account-help {
    display: grid;
    gap: var(--hw-space-3);
    margin-top: var(--hw-space-5);
  }

  .account-help .hw-label {
    margin-bottom: 4px;
    font-size: var(--md-sys-typescale-label-medium-size);
  }

  .account-help p {
    color: var(--md-sys-color-on-surface-variant);
    font-size: var(--md-sys-typescale-body-medium-size);
    line-height: 1.7;
  }

  .account-help-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--hw-space-2) var(--hw-space-3);
  }

  .account-help-actions code {
    color: var(--md-sys-color-on-surface);
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .account-help .text-button,
  .account-help .text-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--md-sys-color-primary);
  }

  .account-foot {
    margin-top: var(--hw-space-5);
    padding-top: var(--hw-space-4);
    border-top: 1px solid var(--md-sys-color-outline-variant);
    color: var(--md-sys-color-on-surface-variant);
    font-size: var(--md-sys-typescale-body-small-size);
    line-height: 1.6;
  }

  .text-link {
    color: var(--md-sys-color-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .account-meta {
    max-width: 30rem;
    margin-top: var(--hw-space-4);
  }

  .account-meta dd {
    font-variant-numeric: tabular-nums;
  }

  .account-actions {
    margin-top: var(--hw-space-5);
  }

  .account-aside {
    padding-top: 0;
  }

  .account-notes {
    display: grid;
    gap: var(--hw-space-4);
    margin-top: var(--hw-space-3);
  }

  .account-notes > div {
    display: grid;
    gap: 2px;
    padding-top: var(--hw-space-4);
    border-top: 1px solid var(--md-sys-color-outline-variant);
  }

  .account-notes > div:first-child {
    padding-top: 0;
    border-top: 0;
  }

  .account-notes dt {
    font-size: var(--md-sys-typescale-title-medium-size);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .account-notes dd {
    color: var(--md-sys-color-on-surface-variant);
    font-size: var(--md-sys-typescale-body-medium-size);
    line-height: 1.65;
  }

  @media (max-width: 839px) {
    .account-layout {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--hw-space-6);
      margin-top: var(--hw-space-5);
    }

    .account-meta {
      max-width: none;
    }

    /* 手机端说明收紧成紧凑行，靠发丝线分组 */
    .account-notes {
      gap: 0;
      margin-top: var(--hw-space-2);
    }

    .account-notes > div {
      padding-block: var(--hw-space-3);
    }

    .account-notes > div:first-child {
      padding-top: 0;
    }
  }
</style>

<script>
  import { safeNextPath } from '../lib/gate';
  import { USERNAME_PATTERN } from '../lib/username';

  interface PublicAccount {
    username: string;
    nickname: string;
    role: 'admin' | 'player';
    createdAt: string;
    lastLoginAt: string | null;
  }

  const memberView = document.querySelector<HTMLElement>('[data-view="member"]');
  const guestView = document.querySelector<HTMLElement>('[data-view="guest"]');
  const headTitle = document.querySelector<HTMLElement>('[data-head-title]');
  const headSub = document.querySelector<HTMLElement>('[data-head-sub]');
  const status = document.querySelector<HTMLElement>('[data-status]');
  const memberStatus = document.querySelector<HTMLElement>('[data-member-status]');
  const form = document.querySelector<HTMLFormElement>('[data-form]');
  const submit = document.querySelector<HTMLButtonElement>('[data-submit]');
  const usernameField = document.querySelector<HTMLElement>('[data-field="username"]');
  const passwordField = document.querySelector<HTMLElement>('[data-field="password"]');
  const usernameInput = form?.querySelector<HTMLInputElement>('input[name="username"]');
  const passwordInput = form?.querySelector<HTMLInputElement>('input[name="password"]');
  const capsNote = document.querySelector<HTMLElement>('[data-caps-lock]');
  const togglePassword = document.querySelector<HTMLButtonElement>('[data-toggle-password]');

  // /gate 会在登录链接里带上 ?next=/gate/，登录成功后回到验证页。
  // 只接受站内路径，避免这个参数变成开放重定向。
  const nextPath = safeNextPath(
    new URLSearchParams(window.location.search).get('next')
  );

  const guestCopy = {
    title: '登录氢风',
    sub: nextPath
      ? '登录后会自动回到进服验证页。账号只在群里发放：@机器人 发「注册 你的游戏ID」。'
      : '账号只在群里发放：@机器人 发「注册 你的游戏ID」，账号和初始密码会私信给你。',
  };

  const setStatus = (node: HTMLElement | null, text: string, tone: 'error' | 'ok' = 'error') => {
    if (!node) return;
    node.textContent = text;
    if (tone === 'ok') node.dataset.tone = 'ok';
    else delete node.dataset.tone;
  };

  const markInvalid = (field: HTMLElement | null, invalid: boolean) => {
    if (!field) return;
    // 状态挂在 .field 上：红框和抖动都靠这个祖先选择器，挂到 .field-control 上 CSS 就找不到
    const label = field.closest<HTMLElement>('.field') ?? field;
    if (invalid) {
      label.dataset.invalid = 'true';
      // 重新挂一次属性，动画才会从头播（连着错两次也能再抖一下）
      delete label.dataset.shake;
      void label.offsetWidth;
      label.dataset.shake = 'true';
      window.setTimeout(() => {
        delete label.dataset.shake;
      }, 300);
    } else {
      delete label.dataset.invalid;
    }
    const input = field.querySelector('input');
    if (invalid) input?.setAttribute('aria-invalid', 'true');
    else input?.removeAttribute('aria-invalid');
  };

  // 一开始改输入就收掉上一次的错误，别让红框和旧提示一直跟着
  const clearFeedback = () => {
    setStatus(status, '');
    markInvalid(usernameField, false);
    markInvalid(passwordField, false);
  };

  usernameInput?.addEventListener('input', clearFeedback);
  passwordInput?.addEventListener('input', clearFeedback);

  const formatTime = (value: string | null): string => {
    if (!value) return '还没有记录';
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) return '还没有记录';
    return new Intl.DateTimeFormat('zh-CN', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    }).format(date);
  };

  const showMember = (account: PublicAccount) => {
    if (headTitle) headTitle.textContent = `你好，${account.nickname}`;
    if (headSub) {
      headSub.textContent = `你正以 ${account.username} 的身份登录氢风。账号和密码由群内机器人发放，改密码请私信机器人。`;
    }

    const role = memberView?.querySelector('[data-member-role]');
    if (role) role.textContent = account.role === 'admin' ? '站务' : '玩家';
    const created = memberView?.querySelector('[data-member-created]');
    if (created) created.textContent = formatTime(account.createdAt);
    const login = memberView?.querySelector('[data-member-login]');
    if (login) login.textContent = formatTime(account.lastLoginAt);

    if (memberView) memberView.hidden = false;
    if (guestView) guestView.hidden = true;
    headTitle?.focus?.();
  };

  const showGuest = () => {
    if (headTitle) headTitle.textContent = guestCopy.title;
    if (headSub) headSub.textContent = guestCopy.sub;
    if (memberView) memberView.hidden = true;
    if (guestView) guestView.hidden = false;
  };

  const loadSession = async () => {
    try {
      const response = await fetch('/api/auth/me', { headers: { accept: 'application/json' } });
      if (!response.ok) {
        showGuest();
        return;
      }
      const result = (await response.json()) as { account?: PublicAccount };
      if (result.account) showMember(result.account);
      else showGuest();
    } catch {
      showGuest();
    }
  };

  /* —— 密码显隐 —— */
  togglePassword?.addEventListener('click', () => {
    if (!passwordInput) return;
    const revealed = passwordInput.type === 'text';
    passwordInput.type = revealed ? 'password' : 'text';
    togglePassword.setAttribute('aria-pressed', String(!revealed));
    togglePassword.setAttribute('aria-label', revealed ? '显示密码' : '隐藏密码');
    const eyes = togglePassword.querySelectorAll('svg');
    // 图标顺序：0 = eye（未显示时用），1 = eye_off（已显示时用）
    eyes.forEach((icon, index) => {
      icon.toggleAttribute('hidden', !revealed ? index === 0 : index === 1);
    });
    const end = passwordInput.value.length;
    passwordInput.setSelectionRange(end, end);
    passwordInput.focus();
  });

  /* —— 大写锁定提示：密码输错最常见的冤枉原因 —— */
  const syncCapsLock = (event: KeyboardEvent) => {
    if (!capsNote) return;
    let on = false;
    try {
      on = event.getModifierState('CapsLock');
    } catch {
      on = false;
    }
    capsNote.hidden = !on;
  };

  passwordInput?.addEventListener('keydown', syncCapsLock);
  passwordInput?.addEventListener('keyup', syncCapsLock);
  passwordInput?.addEventListener('blur', () => {
    if (capsNote) capsNote.hidden = true;
  });

  /* —— 提交 —— */
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    setStatus(status, '');
    markInvalid(usernameField, false);
    markInvalid(passwordField, false);

    const username = usernameInput?.value.trim() ?? '';
    const password = passwordInput?.value ?? '';

    if (!username || !password) {
      if (!username) markInvalid(usernameField, true);
      if (!password) markInvalid(passwordField, true);
      setStatus(status, '账号和密码都要填哦');
      (username ? passwordInput : usernameInput)?.focus();
      return;
    }

    if (!USERNAME_PATTERN.test(username)) {
      markInvalid(usernameField, true);
      setStatus(status, '账号名是 3 到 16 位字母、数字或下划线');
      usernameInput?.focus();
      return;
    }

    if (submit) {
      submit.disabled = true;
      submit.setAttribute('aria-busy', 'true');
      submit.textContent = '正在登录…';
    }

    try {
      const response = await fetch('/api/auth/login', {
        method: 'POST',
        headers: { 'content-type': 'application/json', accept: 'application/json' },
        body: JSON.stringify({ username, password }),
      });
      const result = (await response.json().catch(() => ({}))) as { error?: string };
      if (!response.ok) {
        setStatus(
          status,
          response.status === 429 ? (result.error ?? '尝试太多次了，过几分钟再来') : (result.error ?? '登录失败，稍后再试')
        );
        passwordInput?.select();
        return;
      }
      passwordInput && (passwordInput.value = '');
      if (nextPath) {
        window.location.assign(nextPath);
        return;
      }
      await loadSession();
    } catch {
      setStatus(status, '网络好像不太稳，稍后再试');
    } finally {
      if (submit) {
        submit.disabled = false;
        submit.removeAttribute('aria-busy');
        submit.textContent = '登录';
      }
    }
  });

  const logoutButton = document.querySelector<HTMLButtonElement>('[data-logout]');

  if (logoutButton) {
    logoutButton.addEventListener('click', async () => {
      const original = logoutButton.textContent ?? '退出登录';
      logoutButton.disabled = true;
      logoutButton.setAttribute('aria-busy', 'true');
      logoutButton.textContent = '正在退出…';
      setStatus(memberStatus, '');

      try {
        const response = await fetch('/api/auth/logout', { method: 'POST' });
        if (!response.ok) throw new Error('logout failed');
        showGuest();
        usernameInput?.focus();
      } catch {
        setStatus(memberStatus, '退出失败，稍后再试');
      } finally {
        logoutButton.disabled = false;
        logoutButton.removeAttribute('aria-busy');
        logoutButton.textContent = original;
      }
    });
  }

  // 桌面端进入页面直接把光标放在账号框，手机端不主动唤起键盘
  if (window.matchMedia('(min-width: 840px)').matches) {
    usernameInput?.focus({ preventScroll: true });
  }

  void loadSession();
</script>
