---
// 账号页在构建期出静态壳，登录态由浏览器拉 /api/auth/me 补水，
// 和 /issues/ 保持同一套架构：内容页静态、状态走 /api/*。
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';

const description =
  '氢风（Hydwind）账号中心：登录站内账号，查看身份与最近登录；账号由群内 @机器人 注册后私信发放。';
---

<BaseLayout title="账号 · 氢风 Hydwind" description={description} current="account">
  <section class="hw-shell page-shell account-shell">
    <header class="page-head enter">
      <div class="page-head-copy">
        <h1 data-head-title>登录氢风</h1>
        <p class="page-head-sub" data-head-sub>
          账号只在群里发放：@机器人 发「注册 你的游戏ID」，账号和初始密码会私信给你。
        </p>
      </div>
    </header>

    <div class="account-layout">
      <div class="account-main enter">
        <div class="account-view" data-view="guest">
          <form class="form-stack account-form" data-form novalidate>
            <label class="field">
              <span>账号（游戏 ID）</span>
              <input
                name="username"
                type="text"
                autocomplete="username"
                maxlength="24"
                required
                placeholder="例如 Nz_173"
              />
            </label>
            <label class="field">
              <span>密码</span>
              <input
                name="password"
                type="password"
                autocomplete="current-password"
                required
                placeholder="私信里给你的密码"
              />
            </label>
            <span class="field-hint">登录状态保留 30 天，公共设备记得退出。</span>
            <button class="filled-button account-submit" type="submit">登录</button>
            <p class="form-status" data-status role="status" aria-live="polite"></p>
          </form>
        </div>

        <div class="account-view" data-view="member" hidden>
          <dl class="meta-list-compact account-meta">
            <div>
              <dt>身份</dt>
              <dd data-member-role></dd>
            </div>
            <div>
              <dt>注册时间</dt>
              <dd data-member-created></dd>
            </div>
            <div>
              <dt>最近登录</dt>
              <dd data-member-login></dd>
            </div>
          </dl>
          <div class="page-actions account-actions">
            <a class="filled-button" href="/issues/">
              <Icon name="message" size={18} />
              去议题区
            </a>
            <button class="outlined-button" type="button" data-logout>
              退出登录
            </button>
          </div>
          <p class="form-status" data-member-status role="status" aria-live="polite"></p>
        </div>
      </div>

      <aside class="account-aside enter" style="--enter-delay: 120ms">
        <p class="hw-label">账号说明</p>
        <ol class="account-notes">
          <li>
            <span class="note-index">01</span>
            <h2>账号从群里来</h2>
            <p>在群里 @机器人 发送「注册 你的游戏ID」，机器人会私信账号和初始密码。</p>
          </li>
          <li>
            <span class="note-index">02</span>
            <h2>密码只私信发</h2>
            <p>账号和密码不会公开在群里，改密码同样私信机器人处理。</p>
          </li>
          <li>
            <span class="note-index">03</span>
            <h2>登录能待 30 天</h2>
            <p>登录状态会保留 30 天，公共设备用完请点退出。</p>
          </li>
        </ol>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .account-shell {
    padding-block: clamp(24px, 3.4vw, 40px) var(--hw-space-9);
  }

  .account-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(240px, 0.55fr);
    gap: clamp(28px, 6vw, 88px);
    align-items: start;
    margin-top: clamp(24px, 3vw, 36px);
  }

  .account-form {
    max-width: 25rem;
    margin-top: 0;
    gap: var(--hw-space-3);
  }

  .account-submit {
    justify-self: start;
    min-width: 8rem;
    margin-top: var(--hw-space-2);
  }

  .account-meta {
    max-width: 25rem;
    margin-top: 0;
  }

  .account-actions {
    margin-top: var(--hw-space-5);
  }

  .account-aside {
    padding-top: 0;
  }

  .account-notes {
    display: grid;
    gap: var(--hw-space-4);
    margin-top: var(--hw-space-3);
  }

  .account-notes li {
    display: grid;
    gap: 2px;
    padding-top: var(--hw-space-4);
    border-top: 1px solid var(--md-sys-color-outline-variant);
  }

  .account-notes li:first-child {
    padding-top: 0;
    border-top: 0;
  }

  .note-index {
    color: var(--md-sys-color-on-surface-variant);
    font-size: var(--md-sys-typescale-label-small-size);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.12em;
  }

  .account-notes h2 {
    font-size: var(--md-sys-typescale-title-medium-size);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .account-notes p {
    margin-top: 2px;
    color: var(--md-sys-color-on-surface-variant);
    font-size: var(--md-sys-typescale-body-medium-size);
    line-height: 1.65;
  }

  @media (max-width: 839px) {
    .account-layout {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--hw-space-6);
      margin-top: var(--hw-space-5);
    }

    .account-form,
    .account-meta {
      max-width: none;
    }

    .account-submit {
      width: 100%;
      min-height: 46px;
    }

    /* 手机端说明折成紧凑两列行：序号占窄列，标题与正文并排成一整段 */
    .account-notes {
      gap: 0;
      margin-top: var(--hw-space-2);
    }

    .account-notes li {
      grid-template-columns: 1.75rem minmax(0, 1fr);
      column-gap: var(--hw-space-2);
      row-gap: 0;
      padding-block: var(--hw-space-3);
    }

    .account-notes li:first-child {
      padding-top: 0;
    }

    .note-index {
      grid-column: 1;
      grid-row: 1;
      padding-top: 2px;
    }

    .account-notes h2 {
      grid-column: 2;
      grid-row: 1;
      font-size: var(--md-sys-typescale-title-medium-size);
    }

    .account-notes p {
      grid-column: 2;
      grid-row: 2;
    }
  }
</style>

<script>
  interface PublicAccount {
    username: string;
    nickname: string;
    role: 'admin' | 'player';
    createdAt: string;
    lastLoginAt: string | null;
  }

  const memberView = document.querySelector<HTMLElement>('[data-view="member"]');
  const guestView = document.querySelector<HTMLElement>('[data-view="guest"]');
  const headTitle = document.querySelector<HTMLElement>('[data-head-title]');
  const headSub = document.querySelector<HTMLElement>('[data-head-sub]');
  const status = document.querySelector<HTMLElement>('[data-status]');
  const memberStatus = document.querySelector<HTMLElement>('[data-member-status]');

  const guestCopy = {
    title: '登录氢风',
    sub: '账号只在群里发放：@机器人 发「注册 你的游戏ID」，账号和初始密码会私信给你。',
  };

  const setStatus = (node: HTMLElement | null, text: string) => {
    if (node) node.textContent = text;
  };

  const formatTime = (value: string | null): string => {
    if (!value) return '还没有记录';
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) return '还没有记录';
    return new Intl.DateTimeFormat('zh-CN', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    }).format(date);
  };

  const showMember = (account: PublicAccount) => {
    if (headTitle) headTitle.textContent = `你好，${account.nickname}`;
    if (headSub) {
      headSub.textContent = `你正以 ${account.username} 的身份登录氢风。账号和密码由群内机器人发放，改密码请私信机器人。`;
    }

    const role = memberView?.querySelector('[data-member-role]');
    if (role) role.textContent = account.role === 'admin' ? '站务' : '玩家';
    const created = memberView?.querySelector('[data-member-created]');
    if (created) created.textContent = formatTime(account.createdAt);
    const login = memberView?.querySelector('[data-member-login]');
    if (login) login.textContent = formatTime(account.lastLoginAt);

    if (memberView) memberView.hidden = false;
    if (guestView) guestView.hidden = true;
  };

  const showGuest = () => {
    if (headTitle) headTitle.textContent = guestCopy.title;
    if (headSub) headSub.textContent = guestCopy.sub;
    if (memberView) memberView.hidden = true;
    if (guestView) guestView.hidden = false;
  };

  const loadSession = async () => {
    try {
      const response = await fetch('/api/auth/me', { headers: { accept: 'application/json' } });
      if (!response.ok) {
        showGuest();
        return;
      }
      const result = (await response.json()) as { account?: PublicAccount };
      if (result.account) showMember(result.account);
      else showGuest();
    } catch {
      showGuest();
    }
  };

  const form = document.querySelector<HTMLFormElement>('[data-form]');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    setStatus(status, '');

    const data = new FormData(form);
    const username = String(data.get('username') ?? '').trim();
    const password = String(data.get('password') ?? '');
    if (!username || !password) {
      setStatus(status, '账号和密码都要填哦');
      return;
    }

    const button = form.querySelector('button[type="submit"]');
    if (button instanceof HTMLButtonElement) button.disabled = true;

    try {
      const response = await fetch('/api/auth/login', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ username, password }),
      });
      const result = (await response.json()) as { error?: string };
      if (!response.ok) {
        setStatus(status, result.error ?? '登录失败，稍后再试');
        return;
      }
      await loadSession();
    } catch {
      setStatus(status, '网络好像不太稳，稍后再试');
    } finally {
      if (button instanceof HTMLButtonElement) button.disabled = false;
    }
  });

  document.querySelector('[data-logout]')?.addEventListener('click', async () => {
    await fetch('/api/auth/logout', { method: 'POST' });
    setStatus(memberStatus, '');
    showGuest();
  });

  void loadSession();
</script>
