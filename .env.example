# 复制成 .env 后填写；文件权限 0600，不要提交到仓库。
# 三个令牌都必须至少 32 个随机字符，且互不相同。

# 站务共享密钥：插件 / 机器人调用 /api/auth/register、/api/issues 等写接口
ISSUE_ADMIN_TOKEN=replace-with-32-plus-random-chars

# HydwindGate 专用密钥：只用于 /api/plugin/*
PLUGIN_TOKEN=replace-with-another-32-plus-random-chars

# 会话 HMAC 密钥：只用于 hydwind_session cookie，不能与上面两个相同
SESSION_SECRET=replace-with-a-third-32-plus-random-chars

# 数据目录（账号 / 传记 / 议题 JSON）；不存在时会创建，权限 0700
HYDWIND_DATA_DIR=./data

# 监听地址：放在 Caddy/Nginx 后面时用 127.0.0.1
HOST=127.0.0.1
PORT=4321

# 可选：状态数据源
# STATUS_ENDPOINT=https://api.mcstatus.io/v2/status/java